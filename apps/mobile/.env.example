# Public API origin only — never put secrets in EXPO_PUBLIC_* vars.
#
# Local defaults:
# - iOS Simulator: http://localhost:4000 is fine
# - Expo Go on a phone: leave unset (or localhost) — the app reuses the Expo LAN host
#   so the phone reaches your Mac API automatically.
# - Or pin a LAN IP if you prefer:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.10:4000
#
# EAS preview / production: MUST be https:// (enforced when EAS_BUILD=true).
# EXPO_PUBLIC_API_BASE_URL=https://api.staging.maheraghbar.jo
#
# Optional: Expo associated domain for HTTPS App Links / universal links
# EXPO_ASSOCIATED_DOMAIN=app.maheraghbar.jo
# EAS_PROJECT_ID=bd5ccf7c-9b99-4bc5-a0bc-2a52d781c023

EXPO_PUBLIC_API_BASE_URL=http://localhost:4000
