EXPO_PUBLIC_ENVIRONMENT=local

# Leave EXPO_PUBLIC_API_BASE_URL unset for local development.
# The app then reuses the Expo dev server host, which works on physical
# phones (Expo Go), the iOS simulator, and the Android emulator.
#
# Set it only to pin a specific backend:
# EXPO_PUBLIC_API_BASE_URL=https://api.maher-aghbar.jo
