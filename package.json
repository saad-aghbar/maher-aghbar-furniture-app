{
  "name": "maher-aghbar-furniture-erp",
  "private": true,
  "version": "0.1.0",
  "description": "ERP platform for Maher Al-Aghbar & Sons Furniture",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "smoke:lifecycle": "node scripts/smoke-pdf-lifecycle.mjs",
    "smoke:workflow": "node scripts/smoke-workflow-critical-path.mjs",
    "smoke:factory-uat": "node scripts/smoke-factory-uat.mjs",
    "smoke:factory-lifecycle": "node scripts/factory-lifecycle-uat.mjs",
    "smoke:dynamic-replan-uat": "node scripts/dynamic-replan-live-uat.mjs",
    "smoke:material-wip-uat": "node scripts/material-wip-readiness-live-uat.mjs",
    "smoke:qc-replan-uat": "node scripts/qc-scheduling-replan-live-uat.mjs",
    "smoke:dealer-delivery-uat": "node scripts/dealer-delivery-schedule-live-uat.mjs",
    "smoke:quotation-commercial-uat": "node scripts/quotation-commercial-integrity-live-uat.mjs",
    "smoke:scheduling-sync-uat": "node scripts/scheduling-manual-sync-live-uat.mjs",
    "smoke:scheduling-past-floor-uat": "node scripts/scheduling-past-floor-live-uat.mjs",
    "smoke:stage-material-mrp-uat": "node scripts/stage-material-mrp-live-uat.mjs",
    "smoke:raw-material-images-uat": "node scripts/raw-material-images-live-uat.mjs",
    "smoke:inventory-qr-uat": "node scripts/inventory-qr-identity-live-uat.mjs",
    "smoke:inventory-item-report-uat": "node scripts/inventory-item-report-live-uat.mjs",
    "smoke:production-inventory-lifecycle-uat": "node scripts/production-inventory-lifecycle-live-uat.mjs",
    "smoke:production-wip-handoff-uat": "node scripts/production-wip-handoff-live-uat.mjs",
    "smoke:piece5-manufacturing-cost-uat": "node scripts/smoke-piece5-manufacturing-cost-uat.mjs",
    "smoke:piece6-purchasing-receiving-uat": "node scripts/smoke-piece6-purchasing-receiving-uat.mjs",
    "smoke:piece7-dealer-finance-uat": "node scripts/smoke-piece7-dealer-finance-uat.mjs",
    "smoke:piece8-factory-floor-semi-uat": "node scripts/smoke-piece8-factory-floor-semi-uat.mjs",
    "smoke:piece9-quality-packaging-uat": "node scripts/smoke-piece9-quality-packaging-uat.mjs",
    "smoke:piece10-finished-outbound-uat": "node scripts/smoke-piece10-finished-outbound-uat.mjs",
    "smoke:piece11-exceptions-returns-uat": "node scripts/smoke-piece11-exceptions-returns-uat.mjs",
    "smoke:piece12-management-dashboard-uat": "node scripts/smoke-piece12-management-dashboard-uat.mjs",
    "smoke:piece13-mobile-ux-uat": "node scripts/smoke-piece13-mobile-ux-uat.mjs",
    "smoke:piece14-full-system-uat": "node scripts/smoke-piece14-full-system-uat.mjs",
    "smoke:dev-component-lab": "node scripts/smoke-dev-component-lab.mjs",
    "dev:component-lab:audit": "node scripts/generate-component-lab-classifications.mjs && node scripts/dev-component-lab-audit.mjs",
    "dev:component-lab:generate": "node scripts/generate-component-lab-classifications.mjs",
    "smoke:scheduling-pull-forward-audit": "pnpm --filter @maher/database exec dotenv -e ../../.env -- tsx ../../scripts/scheduling-capacity-pull-forward-audit.mjs",
    "smoke:scope": "node scripts/smoke-scope-isolation.mjs",
    "check:boundaries": "node scripts/check-boundaries.mjs",
    "test:e2e:playwright": "playwright test",
    "db:generate": "pnpm --filter @maher/database generate",
    "db:migrate": "pnpm --filter @maher/database migrate:dev",
    "db:push": "pnpm --filter @maher/database push",
    "db:seed": "pnpm --filter @maher/database seed",
    "db:seed:demo": "pnpm --filter @maher/database seed:demo",
    "db:seed:factory-uat": "pnpm --filter @maher/database seed:factory-uat",
    "demo:reset": "pnpm --filter @maher/database demo:reset",
    "demo:validate": "pnpm --filter @maher/database demo:validate",
    "demo:live-uat": "pnpm --filter @maher/database demo:live-uat",
    "db:studio": "pnpm --filter @maher/database studio",
    "prepare:launch": "bash scripts/prepare-launch.sh",
    "launch": "bash scripts/launch.sh",
    "start:all": "bash scripts/start-all.sh",
    "stop:all": "bash scripts/stop-all.sh",
    "dev:api": "pnpm --filter @maher/api dev",
    "dev:admin": "pnpm --filter @maher/admin-web dev",
    "dev:customer": "pnpm --filter @maher/customer-portal dev",
    "dev:employee": "pnpm --filter @maher/employee-portal dev",
    "dev:mobile": "pnpm --filter @maher/mobile start",
    "dev:apps": "turbo run dev --filter=@maher/api --filter=@maher/admin-web --filter=@maher/customer-portal --filter=@maher/employee-portal --parallel",
    "mobile:start": "pnpm --filter @maher/mobile start",
    "mobile:dev-client": "pnpm --filter @maher/mobile start:dev-client",
    "mobile:android": "pnpm --filter @maher/mobile android",
    "mobile:ios": "pnpm --filter @maher/mobile ios",
    "mobile:ios:device": "pnpm --filter @maher/mobile ios:device",
    "mobile:typecheck": "pnpm --filter @maher/mobile typecheck",
    "mobile:lint": "pnpm --filter @maher/mobile lint",
    "mobile:test": "pnpm --filter @maher/mobile test",
    "mobile:doctor": "pnpm --filter @maher/mobile run doctor",
    "mobile:eas:preview:android": "pnpm --filter @maher/mobile run eas:preview:android",
    "start:api": "pnpm --filter @maher/api start:prod",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\""
  },
  "devDependencies": {
    "@playwright/test": "1.49.1",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "overrides": {
      "@types/react": "18.3.31",
      "@types/react-dom": "18.3.7",
      "@maher/mobile>@types/react": "19.1.17",
      "@maher/mobile>@types/react-dom": "19.1.11"
    }
  }
}
