{
  "name": "maher-aghbar-furniture-erp",
  "private": true,
  "version": "0.1.0",
  "description": "ERP platform for Maher Al-Aghbar & Sons Furniture",
  "packageManager": "pnpm@9.15.9",
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "smoke:lifecycle": "node scripts/smoke-pdf-lifecycle.mjs",
    "smoke:workflow": "node scripts/smoke-workflow-critical-path.mjs",
    "smoke:scope": "node scripts/smoke-scope-isolation.mjs",
    "test:e2e:playwright": "playwright test",
    "db:generate": "pnpm --filter @maher/database generate",
    "db:migrate": "pnpm --filter @maher/database migrate:dev",
    "db:push": "pnpm --filter @maher/database push",
    "db:seed": "pnpm --filter @maher/database seed",
    "db:studio": "pnpm --filter @maher/database studio",
    "prepare:launch": "bash scripts/prepare-launch.sh",
    "launch": "bash scripts/launch.sh",
    "start:all": "bash scripts/start-all.sh",
    "stop:all": "bash scripts/stop-all.sh",
    "dev:api": "pnpm --filter @maher/api dev",
    "dev:admin": "pnpm --filter @maher/admin-web dev",
    "dev:customer": "pnpm --filter @maher/customer-portal dev",
    "dev:employee": "pnpm --filter @maher/employee-portal dev",
    "dev:apps": "turbo run dev --filter=@maher/api --filter=@maher/admin-web --filter=@maher/customer-portal --filter=@maher/employee-portal --parallel",
    "start:api": "pnpm --filter @maher/api start:prod",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,yml}\""
  },
  "devDependencies": {
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
