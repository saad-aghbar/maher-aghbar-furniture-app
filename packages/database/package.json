{
  "name": "@maher/database",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "push": "dotenv -e ../../.env -- prisma db push",
    "seed": "dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:demo": "SEED_FULL_DEMO=1 dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:factory-uat": "SEED_FACTORY_UAT=1 dotenv -e ../../.env -- tsx prisma/seed.ts",
    "seed:floor-uat": "SEED_FULL_DEMO=1 SEED_FLOOR_UAT=1 dotenv -e ../../.env -- tsx prisma/seed.ts",
    "demo:reset": "dotenv -e ../../.env -- tsx prisma/demo/reset.ts",
    "demo:validate": "dotenv -e ../../.env -- tsx prisma/demo/validate-cli.ts",
    "demo:live-uat": "dotenv -e ../../.env -- tsx prisma/demo/live-uat.ts",
    "demo:nile-returns": "dotenv -e ../../.env -- tsx prisma/demo/seed-nile-returns.ts",
    "demo:unique-floor": "dotenv -e ../../.env -- tsx prisma/demo/reseed-unique-floor-workers.ts",
    "demo:terminal-uat": "dotenv -e ../../.env -- tsx prisma/demo/terminal-lifecycle-uat.ts",
    "seed:factory-uat-only": "dotenv -e ../../.env -- tsx prisma/scripts/seed-factory-uat-only.ts",
    "seed:product-photos": "dotenv -e ../../.env -- tsx prisma/seed-product-photos.ts",
    "seed:product-measurements": "dotenv -e ../../.env -- tsx prisma/seed-product-measurements.ts",
    "backfill:default-variants": "dotenv -e ../../.env -- tsx prisma/scripts/backfill-default-variants.ts",
    "backfill:name-he": "dotenv -e ../../.env -- tsx prisma/scripts/backfill-name-he.ts",
    "backfill:sales-order-item-letters": "dotenv -e ../../.env -- tsx prisma/scripts/backfill-sales-order-item-letters.ts",
    "set-passwords-123": "dotenv -e ../../.env -- tsx prisma/set-all-passwords-to-123.ts",
    "repair:protected-stages": "dotenv -e ../../.env -- node prisma/repair-protected-stages.mjs",
    "repair:workflow-scope": "dotenv -e ../../.env -- node prisma/repair-workflow-scope.mjs",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@maher/permissions": "workspace:*",
    "@maher/notifications": "workspace:*",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "bcryptjs": "^2.4.3",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.1.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
