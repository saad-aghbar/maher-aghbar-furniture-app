  goodsReceipt      GoodsReceipt? @relation(fields: [goodsReceiptId], references: [id])
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime?
  currency          String        @default("ILS")
  status            InvoiceStatus @default(ISSUED)
  subtotal          Decimal       @default(0) @db.Decimal(18, 3)
  taxTotal          Decimal       @default(0) @db.Decimal(18, 3)
  total             Decimal       @default(0) @db.Decimal(18, 3)
  paidAmount        Decimal       @default(0) @db.Decimal(18, 3)
  outstandingAmount Decimal       @default(0) @db.Decimal(18, 3)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?
  archivedAt        DateTime?

  lines    SupplierInvoiceLine[]
  payments SupplierPayment[]

  @@index([supplierId])
  @@index([purchaseOrderId])
  @@index([status])
