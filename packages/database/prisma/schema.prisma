  subjectEn String?
  subjectHe String?
  bodyAr    String
  bodyEn    String
  bodyHe    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

// ─── AI Intake ───────────────────────────────────────────────────────────────

model AIExtractionJob {
  id              String              @id @default(uuid())
  number          String              @unique
  requestId       String?
  request         RequestForQuotation? @relation(fields: [requestId], references: [id])
  status          AIJobStatus         @default(UPLOADED)
  sourceType      String
  storageKey      String?
  originalText    String?
  translatedText  String?
