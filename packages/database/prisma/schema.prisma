  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  locale     Locale    @default(ar)
  surface    String
  title      String?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  archivedAt DateTime?
  messages   AiChatMessage[]

  @@index([userId, updatedAt])
  @@map("ai_chat_conversations")
}

model AiChatMessage {
  id             String            @id @default(uuid())
  conversationId String
  conversation   AiChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  blocks         Json
  suggestions    Json?
  createdAt      DateTime          @default(now())

  @@index([conversationId, createdAt])
  @@map("ai_chat_messages")
}

// ─── Production scheduling ────────────────────────────────────────────────────

model ProductProductionProfile {
  id                   String   @id @default(uuid())
  productId            String   @unique
  product              Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  totalStandardMinutes Int?
  setupMinutes         Int      @default(0)
  complexityFactor     Decimal  @default(1) @db.Decimal(8, 3)
  defaultBatchSize     Int      @default(1)
  minimumLeadTimeDays  Int?
  bufferPercent        Int      @default(10)
  isSchedulingEnabled  Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@map("product_production_profiles")
}

model ProductStageEstimate {
  id                   String              @id @default(uuid())
  productId            String
  product              Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  stageDefinitionId    String
  stageDefinition      ProductionStageDefinition @relation(fields: [stageDefinitionId], references: [id])
  setupMinutes         Int                 @default(0)
  minutesPerUnit       Int                 @default(0)
  fixedMinutes         Int                 @default(0)
  quantityScalingMode  QuantityScalingMode @default(SETUP_PLUS_LINEAR)
  batchSize            Int?
  batchMinutes         Int?
  maxParallelUnits     Int?
  workerCountRequired  Int                 @default(1)
  overrideDepartmentId String?
  overrideDepartment   Department?         @relation("StageEstimateOverrideDepartment", fields: [overrideDepartmentId], references: [id])
  isRequired           Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@unique([productId, stageDefinitionId])
  @@index([stageDefinitionId])
  @@map("product_stage_estimates")
}

model FactoryCalendar {
  id               String   @id @default(uuid())
  name             String   @default("Default")
  timezone         String   @default("Asia/Amman")
  /// Weekday numbers 0=Sun .. 6=Sat that are working days (Fri closed by default)
  workingWeekdays  Int[]    @default([0, 1, 2, 3, 4, 6])
  shiftStart       String   @default("08:00")
  shiftEnd         String   @default("16:00")
  /// [{ start: "12:00", end: "13:00" }]
  breaks           Json?
  overtimeConfig   Json?
  isDefault        Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  exceptions FactoryCalendarException[]

  @@map("factory_calendars")
}

model FactoryCalendarException {
  id         String                       @id @default(uuid())
  calendarId String
  calendar   FactoryCalendar              @relation(fields: [calendarId], references: [id], onDelete: Cascade)
  date       DateTime                     @db.Date
  type       FactoryCalendarExceptionType
  shiftStart String?
  shiftEnd   String?
  note       String?
  createdAt  DateTime                     @default(now())

  @@unique([calendarId, date])
  @@index([date])
  @@map("factory_calendar_exceptions")
}

model ProductionSchedule {
  id                        String               @id @default(uuid())
  productionOrderId         String
  productionOrder           ProductionOrder      @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  version                   Int                  @default(1)
  status                    ScheduleStatus       @default(DRAFT)
  promiseState              SchedulePromiseState @default(ESTIMATED)
  requestedDeliveryDate     DateTime?
  earliestAvailableDate     DateTime?
  suggestedDeliveryDate     DateTime?
  committedCompletionDate   DateTime?
  committedDeliveryDate     DateTime?
  calculationVersion        String               @default("v1")
  reason                    String?
  generatedAt               DateTime             @default(now())
  generatedBy               String?
  approvedAt                DateTime?
  approvedById              String?
  approvedBy                User?                @relation("ScheduleApprover", fields: [approvedById], references: [id])
  materialReadyAt           DateTime?
  materialRisk              Boolean              @default(false)
  estimateReviewStatus      EstimateReviewStatus @default(NOT_REQUIRED)
  estimateConfidence        String?
  requiresAdminEstimateReview Boolean            @default(false)
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt

  allocations ScheduleAllocation[]

  @@unique([productionOrderId, version])
  @@index([productionOrderId])
  @@index([status])
  @@index([promiseState])
  @@index([committedDeliveryDate])
  @@index([suggestedDeliveryDate])
  @@map("production_schedules")
}

model ScheduleAllocation {
  id                String               @id @default(uuid())
  scheduleId        String
  schedule          ProductionSchedule   @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  productionTaskId  String?
  productionTask    ProductionTask?      @relation(fields: [productionTaskId], references: [id], onDelete: SetNull)
  stageInstanceId   String?
  stageInstance     ProductionStageInstance? @relation(fields: [stageInstanceId], references: [id], onDelete: SetNull)
  resourceType      ScheduleResourceType @default(EMPLOYEE)
  employeeId        String?
  employee          User?                @relation("AllocationEmployee", fields: [employeeId], references: [id])
  departmentId      String?
  department        Department?          @relation("AllocationDepartment", fields: [departmentId], references: [id])
  plannedStart      DateTime
  plannedEnd        DateTime
  estimatedMinutes  Int
  isPinned          Boolean              @default(false)
  manuallyAdjusted  Boolean              @default(false)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([scheduleId])
  @@index([productionTaskId])
  @@index([employeeId, plannedStart])
  @@index([plannedStart, plannedEnd])
  @@index([departmentId, plannedStart])
  @@map("schedule_allocations")
}

model WorkerSkill {
  id                String   @id @default(uuid())
  userId            String
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  stageDefinitionId String
  stageDefinition   ProductionStageDefinition @relation(fields: [stageDefinitionId], references: [id], onDelete: Cascade)
  proficiency       Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([userId, stageDefinitionId])
  @@index([stageDefinitionId])
  @@map("worker_skills")
}

model SchedulingEstimateProposal {
  id                String                  @id @default(uuid())
  productionOrderId String?
  productionOrder   ProductionOrder?        @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  productId         String?
  requestId         String?
  complexity        ManufacturingComplexity @default(CUSTOM)
  /// [{ stageDefinitionId|stageCode, setupMinutes, minutesPerUnit, fixedMinutes, quantityScalingMode? }]
  stageEstimates    Json
  confidence        String?
  reasons           String[]                @default([])
  status            EstimateReviewStatus    @default(PENDING)
  reviewedAt        DateTime?
  reviewedById      String?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([productionOrderId])
  @@index([status])
  @@map("scheduling_estimate_proposals")
}

model StageEstimateStat {
  id                String   @id @default(uuid())
  productId         String
  product           Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stageDefinitionId String
  stageDefinition   ProductionStageDefinition @relation(fields: [stageDefinitionId], references: [id], onDelete: Cascade)
  sampleSize        Int      @default(0)
  avgActualMinutes  Decimal? @db.Decimal(12, 2)
  medianActualMinutes Decimal? @db.Decimal(12, 2)
  avgEstimatedMinutes Decimal? @db.Decimal(12, 2)
  varianceMinutes   Decimal? @db.Decimal(12, 2)
  suggestedMinutes  Int?
  lastComputedAt    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@unique([productId, stageDefinitionId])
  @@index([stageDefinitionId])
  @@map("stage_estimate_stats")
}

// ─── Production Workflow Templates + Order Snapshots ─────────────────────────

model ProductionWorkflow {
  id              String                   @id @default(uuid())
  code            String                   @unique
  nameAr          String
  nameEn          String
  nameHe          String?
  descriptionAr   String?
  descriptionEn   String?
  descriptionHe   String?
  status          ProductionWorkflowStatus @default(DRAFT)
  activeVersionId String?                  @unique
  activeVersion   ProductionWorkflowVersion? @relation("WorkflowActiveVersion", fields: [activeVersionId], references: [id], onDelete: SetNull)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  archivedAt      DateTime?
  createdById     String?

  versions                ProductionWorkflowVersion[] @relation("WorkflowVersions")
  productConfigurations   ProductWorkflowConfiguration[]
  orderSnapshots          ProductionOrderWorkflowSnapshot[]

  @@index([status])
  @@map("production_workflows")
}

model ProductionWorkflowVersion {
  id            String                           @id @default(uuid())
  workflowId    String
  workflow      ProductionWorkflow               @relation("WorkflowVersions", fields: [workflowId], references: [id], onDelete: Cascade)
  versionNumber Int
  status        ProductionWorkflowVersionStatus  @default(DRAFT)
  name          String
  description   String?
  changelog     String?
  publishedAt   DateTime?
  publishedById String?
  createdAt     DateTime                         @default(now())
  updatedAt     DateTime                         @updatedAt
  createdById   String?
  /// Optimistic concurrency token bumped on every draft mutation
  revision      Int                              @default(1)

  nodes               ProductionWorkflowNode[]
  edges               ProductionWorkflowEdge[]
  activeForWorkflow   ProductionWorkflow? @relation("WorkflowActiveVersion")
  orderSnapshots      ProductionOrderWorkflowSnapshot[]

  @@unique([workflowId, versionNumber])
  @@index([workflowId, status])
  @@map("production_workflow_versions")
}

model ProductionWorkflowNode {
  id                           String                   @id @default(uuid())
  workflowVersionId            String
  workflowVersion              ProductionWorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  stageDefinitionId            String
  stageDefinition              ProductionStageDefinition @relation(fields: [stageDefinitionId], references: [id])
  nodeKey                      String
  sortOrder                    Int                      @default(0)
  displayX                     Float?
  displayY                     Float?
  isRequiredByDefault          Boolean                  @default(true)
  canBeSkipped                 Boolean                  @default(false)
  defaultEstimatedMinutes      Int?
  responsibleDepartmentId      String?
  requiresInspectionOverride   Boolean?
  requiresPhotosOverride       Boolean?
  metadata                     Json?
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt

  outgoingEdges ProductionWorkflowEdge[] @relation("WorkflowEdgeFrom")
  incomingEdges ProductionWorkflowEdge[] @relation("WorkflowEdgeTo")
  productOverrides ProductWorkflowStageOverride[]

  @@unique([workflowVersionId, nodeKey])
  @@index([workflowVersionId])
  @@index([stageDefinitionId])
  @@map("production_workflow_nodes")
}

model ProductionWorkflowEdge {
  id                String                 @id @default(uuid())
  workflowVersionId String
  workflowVersion   ProductionWorkflowVersion @relation(fields: [workflowVersionId], references: [id], onDelete: Cascade)
  fromNodeId        String
  fromNode          ProductionWorkflowNode @relation("WorkflowEdgeFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId          String
  toNode            ProductionWorkflowNode @relation("WorkflowEdgeTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  dependencyType    WorkflowDependencyType @default(HARD)
  createdAt         DateTime               @default(now())

  @@unique([workflowVersionId, fromNodeId, toNodeId])
  @@index([workflowVersionId])
  @@map("production_workflow_edges")
}

model ProductWorkflowConfiguration {
  id         String             @id @default(uuid())
  productId  String             @unique
  product    Product            @relation(fields: [productId], references: [id], onDelete: Cascade)
  workflowId String
  workflow   ProductionWorkflow @relation(fields: [workflowId], references: [id])
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  stageOverrides ProductWorkflowStageOverride[]

  @@index([workflowId])
  @@map("product_workflow_configurations")
}

model ProductWorkflowStageOverride {
  id                    String                   @id @default(uuid())
  configurationId       String
  configuration         ProductWorkflowConfiguration @relation(fields: [configurationId], references: [id], onDelete: Cascade)
  productId             String
  workflowNodeId        String?
  workflowNode          ProductionWorkflowNode?  @relation(fields: [workflowNodeId], references: [id], onDelete: SetNull)
  stageDefinitionId     String
  stageDefinition       ProductionStageDefinition @relation(fields: [stageDefinitionId], references: [id])
  applicability         StageApplicability       @default(INHERIT)
  estimatedMinutes      Int?
  responsibleDepartmentId String?
  createdAt             DateTime                 @default(now())
  updatedAt             DateTime                 @updatedAt

  @@unique([configurationId, stageDefinitionId])
  @@index([productId])
  @@index([workflowNodeId])
  @@index([stageDefinitionId])
  @@map("product_workflow_stage_overrides")
}

model ProductionOrderWorkflowSnapshot {
  id                     String   @id @default(uuid())
  productionOrderId      String   @unique
  productionOrder        ProductionOrder @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  sourceWorkflowId       String?
  sourceWorkflow         ProductionWorkflow? @relation(fields: [sourceWorkflowId], references: [id], onDelete: SetNull)
  sourceWorkflowVersionId String?
  sourceWorkflowVersion  ProductionWorkflowVersion? @relation(fields: [sourceWorkflowVersionId], references: [id], onDelete: SetNull)
  sourceVersionNumber    Int?
  isLegacyBackfill       Boolean  @default(false)
  createdAt              DateTime @default(now())
  customizedAt           DateTime?
  customizedById         String?

  nodes ProductionOrderWorkflowSnapshotNode[]
  edges ProductionOrderWorkflowSnapshotEdge[]

  @@index([sourceWorkflowId])
  @@index([sourceWorkflowVersionId])
  @@map("production_order_workflow_snapshots")
}

model ProductionOrderWorkflowSnapshotNode {
  id                    String   @id @default(uuid())
  snapshotId            String
  snapshot              ProductionOrderWorkflowSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  sourceWorkflowNodeId  String?
  stageDefinitionId     String?
  stageDefinition       ProductionStageDefinition? @relation(fields: [stageDefinitionId], references: [id], onDelete: SetNull)
  stageInstanceId       String?  @unique
  nodeKey               String
  stageCode             String
  nameArSnapshot        String
  nameEnSnapshot        String
  nameHeSnapshot        String?
  isRequired            Boolean  @default(true)
  isSkipped             Boolean  @default(false)
  skipReason            String?
  responsibleDepartmentId String?
  responsibleDepartmentCode String?
  estimatedMinutes      Int?
  estimateReviewRequired Boolean @default(false)
  requiresInspection    Boolean  @default(false)
  requiresPhotos        Boolean  @default(false)
  sortOrder             Int      @default(0)
  displayX              Float?
  displayY              Float?
  metadata              Json?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  outgoingEdges ProductionOrderWorkflowSnapshotEdge[] @relation("SnapshotEdgeFrom")
  incomingEdges ProductionOrderWorkflowSnapshotEdge[] @relation("SnapshotEdgeTo")

  @@unique([snapshotId, nodeKey])
  @@index([snapshotId])
  @@index([stageDefinitionId])
  @@index([stageCode])
  @@map("production_order_workflow_snapshot_nodes")
}

model ProductionOrderWorkflowSnapshotEdge {
  id                   String   @id @default(uuid())
  snapshotId           String
  snapshot             ProductionOrderWorkflowSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  fromSnapshotNodeId   String
  fromSnapshotNode     ProductionOrderWorkflowSnapshotNode @relation("SnapshotEdgeFrom", fields: [fromSnapshotNodeId], references: [id], onDelete: Cascade)
  toSnapshotNodeId     String
  toSnapshotNode       ProductionOrderWorkflowSnapshotNode @relation("SnapshotEdgeTo", fields: [toSnapshotNodeId], references: [id], onDelete: Cascade)
  dependencyType       WorkflowDependencyType @default(HARD)
  createdAt            DateTime @default(now())

  @@unique([snapshotId, fromSnapshotNodeId, toSnapshotNodeId])
  @@index([snapshotId])
  @@map("production_order_workflow_snapshot_edges")
}

