// ─── Audit & Settings ────────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation("AuditActor", fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_events")
}

/** Dedupes mutating API calls (task complete, uploads, notes) across retries. */
model IdempotencyRecord {
  id        String   @id @default(uuid())
  scope     String
  key       String
  userId    String?
  entityId  String?
  response  Json?
  createdAt DateTime @default(now())

  @@unique([scope, key])
  @@index([entityId])
  @@map("idempotency_records")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedById String?

  @@map("system_settings")
}

model SequenceCounter {
  id      String @id @default(uuid())
  key     String
  year    Int
  current Int    @default(0)

  @@unique([key, year])
  @@map("sequence_counters")
}

/** Mobile system chatbot thread (admin or dealer). */
model AiChatConversation {
