generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Locale {
  ar
  en
  he
}

enum CustomerStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  READY_FOR_QUOTATION
  QUOTED
  CLOSED
  CANCELLED
}

enum RequestSource {
  PORTAL
  SALES
  WHATSAPP
  EMAIL
  PDF
  IMAGE
  HANDWRITTEN
  PHONE
  SITE_VISIT
}

enum QuotationStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  REVISION_REQUESTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  WAITING_FOR_PAYMENT
  WAITING_FOR_MATERIALS
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  READY_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum ContractStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  COMPLETED
  TERMINATED
  EXPIRED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  WAITING_FOR_MATERIALS
  READY
  IN_PROGRESS
  ON_HOLD
  QUALITY_CHECK
  READY_FOR_PACKAGING
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum StageInstanceStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

enum TaskStatus {
  NOT_STARTED
  READY
  IN_PROGRESS
  PAUSED
  BLOCKED
  READY_FOR_INSPECTION
  COMPLETED
  CANCELLED
}

enum BlockerCategory {
  MATERIAL_MISSING
  MATERIAL_DEFECT
  MACHINE_PROBLEM
  MEASUREMENT_ISSUE
  DESIGN_ISSUE
  PREVIOUS_STAGE_DEFECT
  STAFFING
  SAFETY
  OTHER
}

enum QualityResult {
  PASSED
  PASSED_WITH_NOTES
  FAILED_REWORK_REQUIRED
  BLOCKED
}

enum ChecklistItemResult {
  PASS
  FAIL
  NOT_APPLICABLE
}

enum DeliveryStatus {
  PLANNED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum ReturnReason {
  MANUFACTURING_DEFECT
  INCORRECT_MEASUREMENT
  INCORRECT_MATERIAL
  INCORRECT_COLOR
  DELIVERY_DAMAGE
  CUSTOMER_REQUEST
  OTHER
}

enum ReturnResolution {
  REPAIR
  REPLACEMENT
  CREDIT_NOTE
  REFUND
  REJECTED
}

enum InventoryTxType {
  PURCHASE_RECEIPT
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  WAREHOUSE_TRANSFER
  INVENTORY_ADJUSTMENT
  CUSTOMER_RETURN
  FINISHED_GOODS_RECEIPT
  DELIVERY_ISSUE
  DAMAGE
  SCRAP
}

enum InventoryCategory {
  WOOD
  FABRIC
  FOAM
  PAINT
  ADHESIVE
  METAL_ACCESSORY
  DECORATIVE_ACCESSORY
  PACKAGING
  SEMI_FINISHED
  FINISHED
  OTHER
}

enum DocumentVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
  DEPARTMENT_ONLY
  MANAGEMENT_ONLY
}

enum AIJobStatus {
  UPLOADED
  QUEUED
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
}

enum CommunicationType {
  PHONE_CALL
  EMAIL
  WHATSAPP
  MEETING
  SITE_VISIT
  NOTE
  FOLLOW_UP
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ─── IAM ─────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  email               String?   @unique
  phone               String?   @unique
  passwordHash        String
  firstName           String
  lastName            String
  preferredLanguage   Locale    @default(ar)
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  isPhoneVerified     Boolean   @default(false)
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  roles              UserRole[]
  sessions           Session[]
  auditEvents        AuditEvent[]           @relation("AuditActor")
  assignedCustomers  Customer[]             @relation("AccountManager")
  communications     CommunicationLog[]
  assignedRequests   RequestForQuotation[]  @relation("RequestAssignee")
  quotationsAsSales  Quotation[]            @relation("QuotationSalesRep")
  quotationApprovals QuotationApproval[]
  productionTasks    ProductionTask[]       @relation("TaskAssignee")
  inspections        QualityInspection[]
  notifications      Notification[]
  documentsUploaded  Document[]             @relation("DocumentUploader")
  timeEntries        TaskTimeEntry[]
  blockersReported   TaskBlocker[]          @relation("BlockerReporter")
  deliveriesAsDriver Delivery[]             @relation("DeliveryDriver")

  @@index([customerId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  nameAr      String
  nameEn      String
  nameHe      String?
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Branch {
  id        String    @id @default(uuid())
  code      String    @unique
  nameAr    String
  nameEn    String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archivedAt DateTime?

  departments Department[]
  warehouses  Warehouse[]

  @@map("branches")
}

model Department {
  id        String    @id @default(uuid())
  code      String    @unique
  nameAr    String
  nameEn    String
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("departments")
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Customer {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  nameAr            String?
  customerType      CustomerType   @default(COMPANY)
  companyName       String?
  commercialRegNo   String?
  taxNumber         String?
  industry          String?
  preferredLanguage Locale         @default(ar)
  phone             String?
  alternativePhone  String?
  email             String?
  website           String?
  accountManagerId  String?
  accountManager    User?          @relation("AccountManager", fields: [accountManagerId], references: [id])
  creditLimit       Decimal?       @db.Decimal(18, 3)
  paymentTermsDays  Int            @default(30)
  status            CustomerStatus @default(LEAD)
  notes             String?
  tags              String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdById       String?
  updatedById       String?
  archivedAt        DateTime?

  contacts       CustomerContact[]
  addresses      CustomerAddress[]
  communications CommunicationLog[]
  users          User[]
  requests       RequestForQuotation[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  contracts      Contract[]
  invoices       Invoice[]
  payments       Payment[]
  statementEntries StatementEntry[]
  returns        ReturnRequest[]
  deliveries     Delivery[]
  documents      Document[]

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([name])
  @@map("customers")
}

model CustomerContact {
  id                String   @id @default(uuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name              String
  position          String?
  phone             String?
  email             String?
  preferredLanguage Locale   @default(ar)
  notes             String?
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  archivedAt        DateTime?

  @@index([customerId])
  @@map("customer_contacts")
}

model CustomerAddress {
  id                   String   @id @default(uuid())
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label                String
  recipient            String?
  phone                String?
  country              String   @default("JO")
  city                 String
  area                 String?
  street               String?
  building             String?
  floor                String?
  postalCode           String?
  additionalInstructions String?
  latitude             Decimal? @db.Decimal(10, 7)
  longitude            Decimal? @db.Decimal(10, 7)
  isDefaultBilling     Boolean  @default(false)
  isDefaultDelivery    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  archivedAt           DateTime?

  @@index([customerId])
  @@map("customer_addresses")
}

model CommunicationLog {
  id              String            @id @default(uuid())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactName     String?
  type            CommunicationType
  subject         String?
  summary         String
  occurredAt      DateTime          @default(now())
  employeeId      String?
  employee        User?             @relation(fields: [employeeId], references: [id])
  nextFollowUpAt  DateTime?
  createdAt       DateTime          @default(now())

  @@index([customerId])
  @@index([occurredAt])
  @@map("communication_logs")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model ProductCategory {
  id        String    @id @default(uuid())
  code      String    @unique
  nameAr    String
  nameEn    String
  nameHe    String?
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("product_categories")
}

model Product {
  id          String          @id @default(uuid())
  sku         String          @unique
  nameAr      String
  nameEn      String
  nameHe      String?
  description String?
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  basePrice   Decimal?        @db.Decimal(18, 3)
  unit        String          @default("pcs")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  quotationLines   QuotationLine[]
  salesOrderLines  SalesOrderLine[]
  productionOrders ProductionOrder[]

  @@index([categoryId])
  @@map("products")
}

model Material {
  id           String            @id @default(uuid())
  sku          String            @unique
  nameAr       String
  nameEn       String
  category     InventoryCategory @default(OTHER)
  unit         String            @default("pcs")
  color        String?
  size         String?
  minStock     Decimal           @default(0) @db.Decimal(18, 3)
  maxStock     Decimal?          @db.Decimal(18, 3)
  reorderQty   Decimal?          @db.Decimal(18, 3)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  archivedAt   DateTime?

  inventoryItem InventoryItem?

  @@map("materials")
}

model Fabric {
  id        String   @id @default(uuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  color     String?
  supplier  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fabrics")
}

model ColorReference {
  id        String   @id @default(uuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  hex       String?
  createdAt DateTime @default(now())

  @@map("color_references")
}

// ─── Suppliers & Purchasing ──────────────────────────────────────────────────

model Supplier {
  id              String    @id @default(uuid())
  code            String    @unique
  name            String
  companyName     String?
  registrationNo  String?
  taxNumber       String?
  phone           String?
  email           String?
  address         String?
  paymentTermsDays Int      @default(30)
  leadTimeDays    Int       @default(7)
  rating          Decimal?  @db.Decimal(3, 2)
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  contacts       SupplierContact[]
  purchaseOrders PurchaseOrder[]

  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_contacts")
}

model PurchaseRequest {
  id               String                @id @default(uuid())
  number           String                @unique
  requestedById    String?
  department       String?
  warehouseId      String?
  warehouse        Warehouse?            @relation(fields: [warehouseId], references: [id])
  requiredDate     DateTime?
  priority         Priority              @default(NORMAL)
  status           PurchaseRequestStatus @default(DRAFT)
  reason           String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  archivedAt       DateTime?

  lines PurchaseRequestLine[]

  @@map("purchase_requests")
}

model PurchaseRequestLine {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  inventoryItemId   String?
  inventoryItem     InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  description       String
  quantity          Decimal         @db.Decimal(18, 3)
  unit              String          @default("pcs")

  @@index([purchaseRequestId])
  @@map("purchase_request_lines")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  number               String              @unique
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId          String?
  warehouse            Warehouse?          @relation(fields: [warehouseId], references: [id])
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  currency             String              @default("JOD")
  paymentTermsDays     Int                 @default(30)
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal             @default(0) @db.Decimal(18, 3)
  taxAmount            Decimal             @default(0) @db.Decimal(18, 3)
  shippingAmount       Decimal             @default(0) @db.Decimal(18, 3)
  total                Decimal             @default(0) @db.Decimal(18, 3)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  archivedAt           DateTime?

  lines         PurchaseOrderLine[]
  goodsReceipts GoodsReceipt[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String
  quantity        Decimal       @db.Decimal(18, 3)
  unitPrice       Decimal       @db.Decimal(18, 3)
  taxRate         Decimal       @default(0) @db.Decimal(5, 4)
  lineTotal       Decimal       @db.Decimal(18, 3)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  number          String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  receiptDate     DateTime      @default(now())
  deliveryDocRef  String?
  notes           String?
  createdAt       DateTime      @default(now())
  createdById     String?

  lines GoodsReceiptLine[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id              String       @id @default(uuid())
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  orderedQty      Decimal      @db.Decimal(18, 3)
  receivedQty     Decimal      @db.Decimal(18, 3)
  rejectedQty     Decimal      @default(0) @db.Decimal(18, 3)
  batchNumber     String?
  qualityStatus   String?

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Warehouse {
  id          String    @id @default(uuid())
  code        String    @unique
  nameAr      String
  nameEn      String
  type        String
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  locations        WarehouseLocation[]
  balances         InventoryBalance[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  transfersFrom    WarehouseTransfer[] @relation("TransferFrom")
  transfersTo      WarehouseTransfer[] @relation("TransferTo")

  @@map("warehouses")
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String?
  createdAt   DateTime  @default(now())

  balances InventoryBalance[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model InventoryItem {
  id          String            @id @default(uuid())
  sku         String            @unique
  barcode     String?           @unique
  qrCode      String?           @unique
  nameAr      String
  nameEn      String
  description String?
  category    InventoryCategory @default(OTHER)
  materialType String?
  color       String?
  size        String?
  unit        String            @default("pcs")
  materialId  String?           @unique
  material    Material?         @relation(fields: [materialId], references: [id])
  minStock    Decimal           @default(0) @db.Decimal(18, 3)
  maxStock    Decimal?          @db.Decimal(18, 3)
  reorderQty  Decimal?          @db.Decimal(18, 3)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  archivedAt  DateTime?

  balances            InventoryBalance[]
  transactions        InventoryTransaction[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines  PurchaseOrderLine[]
  goodsReceiptLines   GoodsReceiptLine[]
  countLines          InventoryCountLine[]
  transferLines       WarehouseTransferLine[]

  @@index([category])
  @@map("inventory_items")
}

model InventoryBalance {
  id              String             @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem      @relation(fields: [inventoryItemId], references: [id])
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  locationId      String?
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])
  availableQty    Decimal            @default(0) @db.Decimal(18, 3)
  reservedQty     Decimal            @default(0) @db.Decimal(18, 3)
  damagedQty      Decimal            @default(0) @db.Decimal(18, 3)
  onOrderQty      Decimal            @default(0) @db.Decimal(18, 3)
  updatedAt       DateTime           @updatedAt

  @@unique([inventoryItemId, warehouseId, locationId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

model InventoryTransaction {
  id              String         @id @default(uuid())
  number          String         @unique
  type            InventoryTxType
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  warehouseId     String
  quantity        Decimal        @db.Decimal(18, 3)
  unitCost        Decimal?       @db.Decimal(18, 3)
  referenceType   String?
  referenceId     String?
  notes           String?
  idempotencyKey  String?        @unique
  createdAt       DateTime       @default(now())
  createdById     String?

  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model InventoryCount {
  id          String   @id @default(uuid())
  number      String   @unique
  warehouseId String
  status      String   @default("DRAFT")
  countedAt   DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  createdById String?

  lines InventoryCountLine[]

  @@map("inventory_counts")
}

model InventoryCountLine {
  id              String         @id @default(uuid())
  inventoryCountId String
  inventoryCount  InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  systemQty       Decimal        @db.Decimal(18, 3)
  countedQty      Decimal?       @db.Decimal(18, 3)
  varianceQty     Decimal?       @db.Decimal(18, 3)

  @@index([inventoryCountId])
  @@map("inventory_count_lines")
}

model WarehouseTransfer {
  id              String   @id @default(uuid())
  number          String   @unique
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          String   @default("DRAFT")
  notes           String?
  createdAt       DateTime @default(now())
  createdById     String?

  lines WarehouseTransferLine[]

  @@map("warehouse_transfers")
}

model WarehouseTransferLine {
  id              String            @id @default(uuid())
  transferId      String
  transfer        WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal           @db.Decimal(18, 3)

  @@index([transferId])
  @@map("warehouse_transfer_lines")
}

// ─── RFQ & Quotations ────────────────────────────────────────────────────────

model RequestForQuotation {
  id                   String        @id @default(uuid())
  number               String        @unique
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  contactName          String?
  source               RequestSource @default(SALES)
  assignedSalesId      String?
  assignedSales        User?         @relation("RequestAssignee", fields: [assignedSalesId], references: [id])
  requestDate          DateTime      @default(now())
  requiredDeliveryDate DateTime?
  status               RequestStatus @default(DRAFT)
  priority             Priority      @default(NORMAL)
  projectName          String?
  deliveryAddress      String?
  currency             String        @default("JOD")
  notes                String?
  internalNotes        String?
  aiProcessingStatus   AIJobStatus?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdById          String?
  archivedAt           DateTime?

  items       RequestItem[]
  quotations  Quotation[]
  aiJobs      AIExtractionJob[]
  documents   Document[]

  @@index([customerId])
  @@index([status])
  @@map("requests_for_quotation")
}

model RequestItem {
  id          String              @id @default(uuid())
  requestId   String
  request     RequestForQuotation @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category    String?
  productName String
  description String?
  quantity    Decimal             @db.Decimal(18, 3)
  unit        String              @default("pcs")
  width       Decimal?            @db.Decimal(18, 3)
  height      Decimal?            @db.Decimal(18, 3)
  depth       Decimal?            @db.Decimal(18, 3)
  seatHeight  Decimal?            @db.Decimal(18, 3)
  material    String?
  woodType    String?
  woodColor   String?
  fabricType  String?
  fabricCode  String?
  fabricColor String?
  foamDensity String?
  finish      String?
  accessories String?
  notes       String?
  sortOrder   Int                 @default(0)

  @@index([requestId])
  @@map("request_items")
}

model Quotation {
  id                   String          @id @default(uuid())
  number               String
  version              Int             @default(1)
  customerId           String
  customer             Customer        @relation(fields: [customerId], references: [id])
  requestId            String?
  request              RequestForQuotation? @relation(fields: [requestId], references: [id])
  issueDate            DateTime        @default(now())
  expirationDate       DateTime?
  currency             String          @default("JOD")
  salesRepId           String?
  salesRep             User?           @relation("QuotationSalesRep", fields: [salesRepId], references: [id])
  status               QuotationStatus @default(DRAFT)
  paymentTerms         String?
  deliveryTerms        String?
  warrantyTerms        String?
  customerNotes        String?
  internalNotes        String?
  subtotal             Decimal         @default(0) @db.Decimal(18, 3)
  discountTotal        Decimal         @default(0) @db.Decimal(18, 3)
  taxTotal             Decimal         @default(0) @db.Decimal(18, 3)
  total                Decimal         @default(0) @db.Decimal(18, 3)
  sentAt               DateTime?
  viewedAt             DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  acceptanceSignature  String?
  parentQuotationId    String?
  parentQuotation      Quotation?      @relation("QuotationRevisions", fields: [parentQuotationId], references: [id])
  revisions            Quotation[]     @relation("QuotationRevisions")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  createdById          String?
  archivedAt           DateTime?

  lines      QuotationLine[]
  approvals  QuotationApproval[]
  salesOrders SalesOrder[]
  documents  Document[]

  @@unique([number, version])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationLine {
  id            String     @id @default(uuid())
  quotationId   String
  quotation     Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?   @relation(fields: [productId], references: [id])
  description   String
  quantity      Decimal    @db.Decimal(18, 3)
  unit          String     @default("pcs")
  width         Decimal?   @db.Decimal(18, 3)
  height        Decimal?   @db.Decimal(18, 3)
  depth         Decimal?   @db.Decimal(18, 3)
  material      String?
  fabric        String?
  color         String?
  unitPrice     Decimal    @db.Decimal(18, 3)
  discountType  DiscountType @default(NONE)
  discountValue Decimal    @default(0) @db.Decimal(18, 3)
  taxRate       Decimal    @default(0) @db.Decimal(5, 4)
  subtotal      Decimal    @db.Decimal(18, 3)
  taxAmount     Decimal    @db.Decimal(18, 3)
  lineTotal     Decimal    @db.Decimal(18, 3)
  sortOrder     Int        @default(0)

  @@index([quotationId])
  @@map("quotation_lines")
}

model QuotationApproval {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User      @relation(fields: [approverId], references: [id])
  decision    String
  comment     String?
  decidedAt   DateTime  @default(now())

  @@index([quotationId])
  @@map("quotation_approvals")
}

// ─── Sales & Contracts ───────────────────────────────────────────────────────

model SalesOrder {
  id                   String           @id @default(uuid())
  number               String           @unique
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  quotationId          String?
  quotation            Quotation?       @relation(fields: [quotationId], references: [id])
  orderDate            DateTime         @default(now())
  requiredDeliveryDate DateTime?
  deliveryAddress      String?
  currency             String           @default("JOD")
  paymentTerms         String?
  status               SalesOrderStatus @default(DRAFT)
  priority             Priority         @default(NORMAL)
  projectName          String?
  assignedEmployeeId   String?
  notes                String?
  subtotal             Decimal          @default(0) @db.Decimal(18, 3)
  taxTotal             Decimal          @default(0) @db.Decimal(18, 3)
  total                Decimal          @default(0) @db.Decimal(18, 3)
  depositRequired      Decimal?         @db.Decimal(18, 3)
  cancellationReason   String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdById          String?
  archivedAt           DateTime?

  lines            SalesOrderLine[]
  contracts        Contract[]
  productionOrders ProductionOrder[]
  deliveries       Delivery[]
  invoices         Invoice[]
  returns          ReturnRequest[]
  documents        Document[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                 String     @id @default(uuid())
  salesOrderId       String
  salesOrder         SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?   @relation(fields: [productId], references: [id])
  description        String
  specifications     String?
  quantity           Decimal    @db.Decimal(18, 3)
  unitPrice          Decimal    @db.Decimal(18, 3)
  discountValue      Decimal    @default(0) @db.Decimal(18, 3)
  taxRate            Decimal    @default(0) @db.Decimal(5, 4)
  lineTotal          Decimal    @db.Decimal(18, 3)
  productionRequired Boolean    @default(true)
  deliveryRequired   Boolean    @default(true)
  sortOrder          Int        @default(0)

  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model Contract {
  id            String         @id @default(uuid())
  number        String         @unique
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  salesOrderId  String?
  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  startDate     DateTime?
  endDate       DateTime?
  contractValue Decimal        @db.Decimal(18, 3)
  currency      String         @default("JOD")
  paymentSchedule String?
  deliveryMilestones String?
  warranty      String?
  terms         String?
  status        ContractStatus @default(DRAFT)
  signedDocId   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  @@index([customerId])
  @@map("contracts")
}

// ─── Production ──────────────────────────────────────────────────────────────

model ProductionStageDefinition {
  id                    String   @id @default(uuid())
  code                  String   @unique
  nameAr                String
  nameEn                String
  nameHe                String?
  sortOrder             Int
  estimatedHours        Decimal? @db.Decimal(8, 2)
  requiresInspection    Boolean  @default(false)
  requiresPhotos        Boolean  @default(false)
  responsibleDepartment String?
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  instances ProductionStageInstance[]
  tasks     ProductionTask[]

  @@map("production_stage_definitions")
}

model ProductionOrder {
  id                    String                @id @default(uuid())
  number                String                @unique
  salesOrderId          String?
  salesOrder            SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  customerId            String?
  productId             String?
  product               Product?              @relation(fields: [productId], references: [id])
  productDescription    String
  quantity              Decimal               @db.Decimal(18, 3)
  specifications        String?
  requiredDeliveryDate  DateTime?
  plannedStartDate      DateTime?
  plannedCompletionDate DateTime?
  actualStartDate       DateTime?
  actualCompletionDate  DateTime?
  priority              Priority              @default(NORMAL)
  currentStageCode      String?
  progressPercent       Int                   @default(0)
  status                ProductionOrderStatus @default(DRAFT)
  supervisorId          String?
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdById           String?
  archivedAt            DateTime?

  stages       ProductionStageInstance[]
  tasks        ProductionTask[]
  inspections  QualityInspection[]
  reworkRequests ReworkRequest[]
  documents    Document[]

  @@index([salesOrderId])
  @@index([status])
  @@map("production_orders")
}

model ProductionStageInstance {
  id                String              @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageDefinitionId String
  stageDefinition   ProductionStageDefinition @relation(fields: [stageDefinitionId], references: [id])
  status            StageInstanceStatus @default(PENDING)
  plannedStart      DateTime?
  plannedEnd        DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  progressPercent   Int                 @default(0)
  notes             String?
  inspectionStatus  String?

  tasks ProductionTask[]

  @@index([productionOrderId])
  @@map("production_stage_instances")
}

model ProductionTask {
  id                  String                     @id @default(uuid())
  number              String                     @unique
  productionOrderId   String
  productionOrder     ProductionOrder            @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageDefinitionId   String?
  stageDefinition     ProductionStageDefinition? @relation(fields: [stageDefinitionId], references: [id])
  stageInstanceId     String?
  stageInstance       ProductionStageInstance?   @relation(fields: [stageInstanceId], references: [id])
  name                String
  description         String?
  assignedEmployeeId  String?
  assignedEmployee    User?                      @relation("TaskAssignee", fields: [assignedEmployeeId], references: [id])
  priority            Priority                   @default(NORMAL)
  plannedStart        DateTime?
  plannedCompletion   DateTime?
  actualStart         DateTime?
  actualCompletion    DateTime?
  progressPercent     Int                        @default(0)
  status              TaskStatus                 @default(NOT_STARTED)
  estimatedMinutes    Int?
  actualMinutes       Int?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  timeEntries TaskTimeEntry[]
  blockers    TaskBlocker[]

  @@index([productionOrderId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@map("production_tasks")
}

model TaskTimeEntry {
  id        String         @id @default(uuid())
  taskId    String
  task      ProductionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?

  @@index([taskId])
  @@map("task_time_entries")
}

model TaskBlocker {
  id           String          @id @default(uuid())
  taskId       String
  task         ProductionTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category     BlockerCategory
  reason       String
  reportedById String?
  reportedBy   User?           @relation("BlockerReporter", fields: [reportedById], references: [id])
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime        @default(now())

  @@index([taskId])
  @@map("task_blockers")
}

// ─── Quality ─────────────────────────────────────────────────────────────────

model QualityChecklistTemplate {
  id        String   @id @default(uuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  stageCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items QualityChecklistItem[]

  @@map("quality_checklist_templates")
}

model QualityChecklistItem {
  id         String                   @id @default(uuid())
  templateId String
  template   QualityChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  code       String
  labelAr    String
  labelEn    String
  sortOrder  Int                      @default(0)

  @@index([templateId])
  @@map("quality_checklist_items")
}

model QualityInspection {
  id                String        @id @default(uuid())
  number            String        @unique
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  stageCode         String?
  inspectorId       String?
  inspector         User?         @relation(fields: [inspectorId], references: [id])
  inspectedAt       DateTime      @default(now())
  result            QualityResult?
  notes             String?
  createdAt         DateTime      @default(now())

  items   QualityInspectionItem[]
  defects QualityDefect[]
  rework  ReworkRequest[]

  @@index([productionOrderId])
  @@map("quality_inspections")
}

model QualityInspectionItem {
  id            String             @id @default(uuid())
  inspectionId  String
  inspection    QualityInspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistCode String
  label         String
  result        ChecklistItemResult?
  note          String?
  severity      String?

  @@index([inspectionId])
  @@map("quality_inspection_items")
}

model QualityDefect {
  id             String            @id @default(uuid())
  inspectionId   String
  inspection     QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  description    String
  stageCode      String?
  severity       String
  correctiveAction String?

  @@index([inspectionId])
  @@map("quality_defects")
}

model ReworkRequest {
  id                String             @id @default(uuid())
  number            String             @unique
  productionOrderId String
  productionOrder   ProductionOrder    @relation(fields: [productionOrderId], references: [id])
  inspectionId      String?
  inspection        QualityInspection? @relation(fields: [inspectionId], references: [id])
  description       String
  assignedToId      String?
  status            String             @default("OPEN")
  createdAt         DateTime           @default(now())
  completedAt       DateTime?

  @@index([productionOrderId])
  @@map("rework_requests")
}

// ─── Delivery ────────────────────────────────────────────────────────────────

model Delivery {
  id              String         @id @default(uuid())
  number          String         @unique
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  deliveryAddress String
  deliveryDate    DateTime?
  deliveryWindow  String?
  driverId        String?
  driver          User?          @relation("DeliveryDriver", fields: [driverId], references: [id])
  vehicle         String?
  status          DeliveryStatus @default(PLANNED)
  recipientName   String?
  signatureData   String?
  failureReason   String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items DeliveryItem[]

  @@index([customerId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryItem {
  id          String   @id @default(uuid())
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(18, 3)

  @@index([deliveryId])
  @@map("delivery_items")
}

// ─── Accounting ──────────────────────────────────────────────────────────────

model Invoice {
  id                String        @id @default(uuid())
  number            String        @unique
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime?
  currency          String        @default("JOD")
  status            InvoiceStatus @default(DRAFT)
  subtotal          Decimal       @default(0) @db.Decimal(18, 3)
  discountTotal     Decimal       @default(0) @db.Decimal(18, 3)
  taxTotal          Decimal       @default(0) @db.Decimal(18, 3)
  total             Decimal       @default(0) @db.Decimal(18, 3)
  paidAmount        Decimal       @default(0) @db.Decimal(18, 3)
  outstandingAmount Decimal       @default(0) @db.Decimal(18, 3)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?
  archivedAt        DateTime?

  lines    InvoiceLine[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 3)
  taxRate     Decimal @default(0) @db.Decimal(5, 4)
  lineTotal   Decimal @db.Decimal(18, 3)
  sortOrder   Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id              String        @id @default(uuid())
  number          String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(18, 3)
  currency        String        @default("JOD")
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  bank            String?
  notes           String?
  createdAt       DateTime      @default(now())
  createdById     String?
  idempotencyKey  String?       @unique

  @@index([customerId])
  @@index([invoiceId])
  @@map("payments")
}

model StatementEntry {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  entryDate   DateTime
  type        String
  reference   String?
  debit       Decimal  @default(0) @db.Decimal(18, 3)
  credit      Decimal  @default(0) @db.Decimal(18, 3)
  balance     Decimal  @db.Decimal(18, 3)
  description String?
  createdAt   DateTime @default(now())

  @@index([customerId, entryDate])
  @@map("statement_entries")
}

model ReturnRequest {
  id           String            @id @default(uuid())
  number       String            @unique
  customerId   String
  customer     Customer          @relation(fields: [customerId], references: [id])
  salesOrderId String?
  salesOrder   SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  productDesc  String
  quantity     Decimal           @db.Decimal(18, 3)
  reason       ReturnReason
  description  String?
  approvalStatus String          @default("PENDING")
  resolution   ReturnResolution?
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt

  @@index([customerId])
  @@map("return_requests")
}

// ─── Documents & Notifications ───────────────────────────────────────────────

model Document {
  id               String             @id @default(uuid())
  fileName         String
  mimeType         String
  sizeBytes        Int
  storageKey       String
  category         String?
  visibility       DocumentVisibility @default(INTERNAL)
  version          Int                @default(1)
  description      String?
  uploadedById     String?
  uploadedBy       User?              @relation("DocumentUploader", fields: [uploadedById], references: [id])
  customerId       String?
  customer         Customer?          @relation(fields: [customerId], references: [id])
  requestId        String?
  request          RequestForQuotation? @relation(fields: [requestId], references: [id])
  quotationId      String?
  quotation        Quotation?         @relation(fields: [quotationId], references: [id])
  salesOrderId     String?
  salesOrder       SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  productionOrderId String?
  productionOrder  ProductionOrder?   @relation(fields: [productionOrderId], references: [id])
  createdAt        DateTime           @default(now())
  archivedAt       DateTime?

  @@index([customerId])
  @@map("documents")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  titleAr   String
  titleEn   String
  bodyAr    String
  bodyEn    String
  linkUrl   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
  @@map("notifications")
}

model NotificationTemplate {
  id        String   @id @default(uuid())
  code      String   @unique
  channel   String
  subjectAr String?
  subjectEn String?
  subjectHe String?
  bodyAr    String
  bodyEn    String
  bodyHe    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("notification_templates")
}

// ─── AI Intake ───────────────────────────────────────────────────────────────

model AIExtractionJob {
  id              String              @id @default(uuid())
  number          String              @unique
  requestId       String?
  request         RequestForQuotation? @relation(fields: [requestId], references: [id])
  status          AIJobStatus         @default(UPLOADED)
  sourceType      String
  storageKey      String?
  originalText    String?
  translatedText  String?
  detectedLanguage Locale?
  targetLanguage  Locale              @default(ar)
  provider        String?
  errorMessage    String?
  reviewedById    String?
  reviewedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  fields AIExtractionField[]

  @@map("ai_extraction_jobs")
}

model AIExtractionField {
  id           String          @id @default(uuid())
  jobId        String
  job          AIExtractionJob @relation(fields: [jobId], references: [id], onDelete: Cascade)
  fieldName    String
  fieldValue   String?
  confidence   Decimal?        @db.Decimal(5, 4)
  isMissing    Boolean         @default(false)
  reviewedValue String?

  @@index([jobId])
  @@map("ai_extraction_fields")
}

// ─── Audit & Settings ────────────────────────────────────────────────────────

model AuditEvent {
  id         String   @id @default(uuid())
  userId     String?
  user       User?    @relation("AuditActor", fields: [userId], references: [id])
  action     String
  entityType String
  entityId   String?
  oldValues  Json?
  newValues  Json?
  ipAddress  String?
  userAgent  String?
  requestId  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_events")
}

model SystemSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
  updatedById String?

  @@map("system_settings")
}

model SequenceCounter {
  id      String @id @default(uuid())
  key     String
  year    Int
  current Int    @default(0)

  @@unique([key, year])
  @@map("sequence_counters")
}
