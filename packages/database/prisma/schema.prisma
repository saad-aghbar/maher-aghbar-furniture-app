generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum Locale {
  ar
  en
  he
}

enum CustomerStatus {
  LEAD
  PROSPECT
  ACTIVE
  INACTIVE
  BLOCKED
}

enum CustomerType {
  INDIVIDUAL
  COMPANY
  SHOWROOM
}

enum RequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  NEEDS_INFORMATION
  READY_FOR_QUOTATION
  QUOTED
  CLOSED
  CANCELLED
}

enum RequestSource {
  PORTAL
  SALES
  WHATSAPP
  EMAIL
  PDF
  IMAGE
  HANDWRITTEN
  PHONE
  SITE_VISIT
}

enum QuotationStatus {
  DRAFT
  INTERNAL_REVIEW
  APPROVED
  SENT
  VIEWED
  ACCEPTED
  REJECTED
  REVISION_REQUESTED
  EXPIRED
  CANCELLED
}

enum SalesOrderStatus {
  DRAFT
  CONFIRMED
  WAITING_FOR_PAYMENT
  WAITING_FOR_MATERIALS
  READY_FOR_PRODUCTION
  IN_PRODUCTION
  READY_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum ContractStatus {
  DRAFT
  UNDER_REVIEW
  ACTIVE
  COMPLETED
  TERMINATED
  EXPIRED
}

enum PurchaseRequestStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  ORDERED
  CLOSED
}

enum PurchaseOrderStatus {
  DRAFT
  APPROVED
  SENT
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
  CLOSED
}

enum ProductionOrderStatus {
  DRAFT
  PLANNED
  WAITING_FOR_MATERIALS
  READY
  IN_PROGRESS
  ON_HOLD
  QUALITY_CHECK
  READY_FOR_PACKAGING
  READY_FOR_DELIVERY
  COMPLETED
  CANCELLED
}

enum StageInstanceStatus {
  PENDING
  READY
  IN_PROGRESS
  COMPLETED
  SKIPPED
  BLOCKED
}

enum TaskStatus {
  NOT_STARTED
  READY
  IN_PROGRESS
  PAUSED
  BLOCKED
  READY_FOR_INSPECTION
  COMPLETED
  CANCELLED
}

enum BlockerCategory {
  MATERIAL_MISSING
  MATERIAL_DEFECT
  MACHINE_PROBLEM
  MEASUREMENT_ISSUE
  DESIGN_ISSUE
  PREVIOUS_STAGE_DEFECT
  STAFFING
  SAFETY
  OTHER
}

enum QualityResult {
  PASSED
  PASSED_WITH_NOTES
  FAILED_REWORK_REQUIRED
  BLOCKED
}

enum ChecklistItemResult {
  PASS
  FAIL
  NOT_APPLICABLE
}

enum DeliveryStatus {
  PLANNED
  READY
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  RESCHEDULED
  CANCELLED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
  CANCELLED
}

enum PaymentMethod {
  CASH
  BANK_TRANSFER
  CHEQUE
  CARD
  OTHER
}

enum ReturnReason {
  MANUFACTURING_DEFECT
  INCORRECT_MEASUREMENT
  INCORRECT_MATERIAL
  INCORRECT_COLOR
  DELIVERY_DAMAGE
  CUSTOMER_REQUEST
  OTHER
}

enum ReturnResolution {
  REPAIR
  REPLACEMENT
  CREDIT_NOTE
  REFUND
  REJECTED
}

enum InventoryTxType {
  PURCHASE_RECEIPT
  PRODUCTION_ISSUE
  PRODUCTION_RETURN
  WAREHOUSE_TRANSFER
  INVENTORY_ADJUSTMENT
  CUSTOMER_RETURN
  FINISHED_GOODS_RECEIPT
  DELIVERY_ISSUE
  DAMAGE
  SCRAP
}

enum InventoryCategory {
  WOOD
  FABRIC
  FOAM
  PAINT
  ADHESIVE
  METAL_ACCESSORY
  DECORATIVE_ACCESSORY
  PACKAGING
  SEMI_FINISHED
  FINISHED
  OTHER
}

enum DocumentVisibility {
  INTERNAL
  CUSTOMER_VISIBLE
  DEPARTMENT_ONLY
  MANAGEMENT_ONLY
}

enum AIJobStatus {
  UPLOADED
  QUEUED
  PROCESSING
  NEEDS_REVIEW
  COMPLETED
  FAILED
}

enum CommunicationType {
  PHONE_CALL
  EMAIL
  WHATSAPP
  MEETING
  SITE_VISIT
  NOTE
  FOLLOW_UP
}

enum DiscountType {
  NONE
  PERCENT
  AMOUNT
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

enum QuantityScalingMode {
  LINEAR
  FIXED
  SETUP_PLUS_LINEAR
  BATCH
  PARALLEL_CAPACITY
}

enum ScheduleStatus {
  DRAFT
  PROPOSED
  APPROVED
  SUPERSEDED
  CANCELLED
  NEEDS_REVIEW
  PROVISIONAL
}

enum SchedulePromiseState {
  ESTIMATED
  AWAITING_APPROVAL
  CONFIRMED
  AT_RISK
  RESCHEDULED
  COMPLETED
}

enum ManufacturingComplexity {
  STANDARD
  MODIFIED
  CUSTOM
}

enum ScheduleResourceType {
  EMPLOYEE
  DEPARTMENT
}

enum EstimateReviewStatus {
  NOT_REQUIRED
  PENDING
  APPROVED
  REJECTED
}

enum FactoryCalendarExceptionType {
  HOLIDAY
  SHUTDOWN
  EXTRA_SHIFT
}

enum ProductionWorkflowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductionWorkflowVersionStatus {
  DRAFT
  PUBLISHED
  SUPERSEDED
  ARCHIVED
}

enum WorkflowDependencyType {
  HARD
}

enum StageApplicability {
  INHERIT
  REQUIRED
  OPTIONAL
  EXCLUDED
}

// ─── IAM ─────────────────────────────────────────────────────────────────────

model User {
  id                  String    @id @default(uuid())
  username            String?   @unique
  email               String?   @unique
  phone               String?   @unique
  passwordHash        String
  /** AES-GCM blob of the dealer portal password (null for staff). Never expose in list/detail selects. */
  portalPasswordEnc   String?
  firstName           String
  lastName            String
  preferredLanguage   Locale    @default(ar)
  isActive            Boolean   @default(true)
  isEmailVerified     Boolean   @default(false)
  isPhoneVerified     Boolean   @default(false)
  mfaEnabled          Boolean   @default(false)
  mfaSecret           String?
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  lastLoginAt         DateTime?
  customerId          String?
  customer            Customer? @relation(fields: [customerId], references: [id])
  departmentId        String?
  department          Department? @relation(fields: [departmentId], references: [id])
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  archivedAt          DateTime?

  roles              UserRole[]
  sessions           Session[]
  auditEvents        AuditEvent[]           @relation("AuditActor")
  assignedCustomers  Customer[]             @relation("AccountManager")
  communications     CommunicationLog[]
  assignedRequests   RequestForQuotation[]  @relation("RequestAssignee")
  quotationsAsSales  Quotation[]            @relation("QuotationSalesRep")
  quotationApprovals QuotationApproval[]
  productionTasks    ProductionTask[]       @relation("TaskAssignee")
  inspections        QualityInspection[]
  notifications      Notification[]
  pushTokens         DevicePushToken[]
  documentsUploaded  Document[]             @relation("DocumentUploader")
  timeEntries        TaskTimeEntry[]
  blockersReported   TaskBlocker[]          @relation("BlockerReporter")
  deliveriesAsDriver Delivery[]             @relation("DeliveryDriver")
  aiChatConversations AiChatConversation[]
  workerSkills       WorkerSkill[]
  scheduleAllocations ScheduleAllocation[]  @relation("AllocationEmployee")
  schedulesApproved  ProductionSchedule[]   @relation("ScheduleApprover")

  @@index([customerId])
  @@index([departmentId])
  @@map("users")
}

model Role {
  id          String           @id @default(uuid())
  code        String           @unique
  nameAr      String
  nameEn      String
  nameHe      String?
  description String?
  permissions RolePermission[]
  users       UserRole[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@map("roles")
}

model Permission {
  id          String           @id @default(uuid())
  code        String           @unique
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model UserRole {
  userId     String
  roleId     String
  assignedAt DateTime @default(now())
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String
  permissionId String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id               String    @id @default(uuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@index([userId])
  @@index([refreshTokenHash])
  @@map("sessions")
}

model Branch {
  id        String    @id @default(uuid())
  code      String    @unique
  nameAr    String
  nameEn    String
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  archivedAt DateTime?

  departments Department[]
  warehouses  Warehouse[]

  @@map("branches")
}

model Department {
  id        String    @id @default(uuid())
  code      String    @unique
  nameAr    String
  nameEn    String
  branchId  String?
  branch    Branch?   @relation(fields: [branchId], references: [id])
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  users     User[]
  stageEstimateOverrides ProductStageEstimate[] @relation("StageEstimateOverrideDepartment")
  scheduleAllocations    ScheduleAllocation[]   @relation("AllocationDepartment")

  @@map("departments")
}

// ─── CRM ─────────────────────────────────────────────────────────────────────

model Customer {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  nameAr            String?
  nameEn            String?
  nameHe            String?
  customerType      CustomerType   @default(COMPANY)
  companyName       String?
  commercialRegNo   String?
  taxNumber         String?
  industry          String?
  preferredLanguage Locale         @default(ar)
  phone             String?
  fax               String?
  alternativePhone  String?
  email             String?
  website           String?
  accountManagerId  String?
  accountManager    User?          @relation("AccountManager", fields: [accountManagerId], references: [id])
  creditLimit       Decimal?       @db.Decimal(18, 3)
  paymentTermsDays  Int            @default(30)
  status            CustomerStatus @default(LEAD)
  notes             String?
  tags              String[]       @default([])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  createdById       String?
  updatedById       String?
  archivedAt        DateTime?

  contacts       CustomerContact[]
  addresses      CustomerAddress[]
  communications CommunicationLog[]
  users          User[]
  requests       RequestForQuotation[]
  quotations     Quotation[]
  salesOrders    SalesOrder[]
  contracts      Contract[]
  invoices       Invoice[]
  payments       Payment[]
  statementEntries StatementEntry[]
  returns        ReturnRequest[]
  deliveries     Delivery[]
  documents      Document[]
  dealerPrices   DealerPrice[]

  @@index([status])
  @@index([phone])
  @@index([email])
  @@index([name])
  @@map("customers")
}

model CustomerContact {
  id                String   @id @default(uuid())
  customerId        String
  customer          Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name              String
  position          String?
  phone             String?
  email             String?
  preferredLanguage Locale   @default(ar)
  notes             String?
  isPrimary         Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  archivedAt        DateTime?

  @@index([customerId])
  @@map("customer_contacts")
}

model CustomerAddress {
  id                   String   @id @default(uuid())
  customerId           String
  customer             Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  label                String
  recipient            String?
  phone                String?
  country              String   @default("JO")
  city                 String
  area                 String?
  street               String?
  building             String?
  floor                String?
  postalCode           String?
  additionalInstructions String?
  latitude             Decimal? @db.Decimal(10, 7)
  longitude            Decimal? @db.Decimal(10, 7)
  isDefaultBilling     Boolean  @default(false)
  isDefaultDelivery    Boolean  @default(false)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  archivedAt           DateTime?

  @@index([customerId])
  @@map("customer_addresses")
}

model CommunicationLog {
  id              String            @id @default(uuid())
  customerId      String
  customer        Customer          @relation(fields: [customerId], references: [id], onDelete: Cascade)
  contactName     String?
  type            CommunicationType
  subject         String?
  summary         String
  occurredAt      DateTime          @default(now())
  employeeId      String?
  employee        User?             @relation(fields: [employeeId], references: [id])
  nextFollowUpAt  DateTime?
  createdAt       DateTime          @default(now())

  @@index([customerId])
  @@index([occurredAt])
  @@map("communication_logs")
}

// ─── Catalog ─────────────────────────────────────────────────────────────────

model ProductCategory {
  id        String    @id @default(uuid())
  code      String    @unique
  nameAr    String
  nameEn    String
  nameHe    String?
  parentId  String?
  parent    ProductCategory?  @relation("CategoryTree", fields: [parentId], references: [id])
  children  ProductCategory[] @relation("CategoryTree")
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@map("product_categories")
}

model Product {
  id          String          @id @default(uuid())
  sku         String          @unique
  nameAr      String
  nameEn      String
  nameHe      String?
  description String?
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id])
  basePrice   Decimal?        @db.Decimal(18, 3)
  unit        String          @default("pcs")
  isActive    Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  archivedAt  DateTime?

  imageUrl         String?
  galleryUrls      String[]         @default([])
  manufacturingCost Decimal?        @db.Decimal(18, 3)
  /// Default BOM quantities/costs for costing stubs
  bomDefaults      Json?
  width            Decimal?         @db.Decimal(18, 3)
  height           Decimal?         @db.Decimal(18, 3)
  depth            Decimal?         @db.Decimal(18, 3)
  seatHeight       Decimal?         @db.Decimal(18, 3)
  /// Extra named measurements: [{ id, nameEn, nameAr, nameHe?, value }]
  customMeasurements Json?
  /// Internal factory notes — admin only (never shown to dealers)
  adminNotes       String?

  quotationLines   QuotationLine[]
  salesOrderLines  SalesOrderLine[]
  productionOrders ProductionOrder[]
  dealerPrices     DealerPrice[]
  requestItems     RequestItem[]
  productionProfile ProductProductionProfile?
  stageEstimates    ProductStageEstimate[]
  estimateStats     StageEstimateStat[]
  workflowConfiguration ProductWorkflowConfiguration?

  @@index([categoryId])
  @@map("products")
}

/// Per-dealer selling price for a catalog product
model DealerPrice {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  price      Decimal  @db.Decimal(18, 3)
  currency   String   @default("ILS")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([customerId, productId])
  @@index([customerId])
  @@index([productId])
  @@map("dealer_prices")
}

model Material {
  id           String            @id @default(uuid())
  sku          String            @unique
  nameAr       String
  nameEn       String
  category     InventoryCategory @default(OTHER)
  unit         String            @default("pcs")
  color        String?
  size         String?
  minStock     Decimal           @default(0) @db.Decimal(18, 3)
  maxStock     Decimal?          @db.Decimal(18, 3)
  reorderQty   Decimal?          @db.Decimal(18, 3)
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  archivedAt   DateTime?

  inventoryItem InventoryItem?

  @@map("materials")
}

model Fabric {
  id        String   @id @default(uuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  color     String?
  supplier  String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("fabrics")
}

model ColorReference {
  id        String   @id @default(uuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  nameHe    String?
  hex       String?
  createdAt DateTime @default(now())

  @@map("color_references")
}

// ─── Suppliers & Purchasing ──────────────────────────────────────────────────

model Supplier {
  id              String    @id @default(uuid())
  code            String    @unique
  name            String
  nameAr          String?
  nameEn          String?
  nameHe          String?
  companyName     String?
  registrationNo  String?
  taxNumber       String?
  phone           String?
  email           String?
  address         String?
  paymentTermsDays Int      @default(30)
  leadTimeDays    Int       @default(7)
  rating          Decimal?  @db.Decimal(3, 2)
  isCertified     Boolean   @default(false)
  status          String    @default("ACTIVE")
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  archivedAt      DateTime?

  contacts         SupplierContact[]
  purchaseOrders   PurchaseOrder[]
  quoteOffers      SupplierQuoteOffer[]
  preferredPurchaseRequests PurchaseRequest[] @relation("PurchaseRequestPreferredSupplier")
  supplierInvoices SupplierInvoice[]
  supplierPayments SupplierPayment[]
  preferredForItems InventoryItem[]

  @@map("suppliers")
}

model SupplierContact {
  id         String   @id @default(uuid())
  supplierId String
  supplier   Supplier @relation(fields: [supplierId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  isPrimary  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@index([supplierId])
  @@map("supplier_contacts")
}

model PurchaseRequest {
  id               String                @id @default(uuid())
  number           String                @unique
  requestedById    String?
  department       String?
  warehouseId      String?
  warehouse        Warehouse?            @relation(fields: [warehouseId], references: [id])
  preferredSupplierId String?
  preferredSupplier   Supplier?          @relation("PurchaseRequestPreferredSupplier", fields: [preferredSupplierId], references: [id])
  requiredDate     DateTime?
  priority         Priority              @default(NORMAL)
  status           PurchaseRequestStatus @default(DRAFT)
  reason           String?
  purchaseOrderId  String?               @unique
  purchaseOrder    PurchaseOrder?        @relation(fields: [purchaseOrderId], references: [id])
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  archivedAt       DateTime?

  lines  PurchaseRequestLine[]
  offers SupplierQuoteOffer[]

  @@index([preferredSupplierId])
  @@map("purchase_requests")
}

model SupplierQuoteOffer {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  supplierId        String
  supplier          Supplier        @relation(fields: [supplierId], references: [id])
  unitPrice         Decimal         @db.Decimal(18, 3)
  currency          String          @default("ILS")
  leadTimeDays      Int?
  qualityScore      Decimal?        @db.Decimal(3, 2)
  notes             String?
  isSelected        Boolean         @default(false)
  createdAt         DateTime        @default(now())

  @@index([purchaseRequestId])
  @@map("supplier_quote_offers")
}

model PurchaseRequestLine {
  id                String          @id @default(uuid())
  purchaseRequestId String
  purchaseRequest   PurchaseRequest @relation(fields: [purchaseRequestId], references: [id], onDelete: Cascade)
  inventoryItemId   String?
  inventoryItem     InventoryItem?  @relation(fields: [inventoryItemId], references: [id])
  description       String
  quantity          Decimal         @db.Decimal(18, 3)
  unit              String          @default("pcs")

  @@index([purchaseRequestId])
  @@map("purchase_request_lines")
}

model PurchaseOrder {
  id                   String              @id @default(uuid())
  number               String              @unique
  supplierId           String
  supplier             Supplier            @relation(fields: [supplierId], references: [id])
  warehouseId          String?
  warehouse            Warehouse?          @relation(fields: [warehouseId], references: [id])
  orderDate            DateTime            @default(now())
  expectedDeliveryDate DateTime?
  currency             String              @default("ILS")
  paymentTermsDays     Int                 @default(30)
  status               PurchaseOrderStatus @default(DRAFT)
  subtotal             Decimal             @default(0) @db.Decimal(18, 3)
  taxAmount            Decimal             @default(0) @db.Decimal(18, 3)
  shippingAmount       Decimal             @default(0) @db.Decimal(18, 3)
  total                Decimal             @default(0) @db.Decimal(18, 3)
  notes                String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  archivedAt           DateTime?

  lines            PurchaseOrderLine[]
  goodsReceipts    GoodsReceipt[]
  purchaseRequest  PurchaseRequest?
  supplierInvoices SupplierInvoice[]

  @@index([supplierId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderLine {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  description     String
  quantity        Decimal       @db.Decimal(18, 3)
  unit            String        @default("pcs")
  unitPrice       Decimal       @db.Decimal(18, 3)
  taxRate         Decimal       @default(0) @db.Decimal(5, 4)
  lineTotal       Decimal       @db.Decimal(18, 3)

  @@index([purchaseOrderId])
  @@map("purchase_order_lines")
}

model GoodsReceipt {
  id              String        @id @default(uuid())
  number          String        @unique
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouseId     String
  warehouse       Warehouse     @relation(fields: [warehouseId], references: [id])
  receiptDate     DateTime      @default(now())
  deliveryDocRef  String?
  notes           String?
  createdAt       DateTime      @default(now())
  createdById     String?

  lines            GoodsReceiptLine[]
  supplierInvoices SupplierInvoice[]

  @@index([purchaseOrderId])
  @@map("goods_receipts")
}

model GoodsReceiptLine {
  id              String       @id @default(uuid())
  goodsReceiptId  String
  goodsReceipt    GoodsReceipt @relation(fields: [goodsReceiptId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  orderedQty      Decimal      @db.Decimal(18, 3)
  receivedQty     Decimal      @db.Decimal(18, 3)
  rejectedQty     Decimal      @default(0) @db.Decimal(18, 3)
  batchNumber     String?
  qualityStatus   String?

  @@index([goodsReceiptId])
  @@map("goods_receipt_lines")
}

// ─── Inventory ───────────────────────────────────────────────────────────────

model Warehouse {
  id          String    @id @default(uuid())
  code        String    @unique
  nameAr      String
  nameEn      String
  type        String
  branchId    String?
  branch      Branch?   @relation(fields: [branchId], references: [id])
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  locations        WarehouseLocation[]
  balances         InventoryBalance[]
  purchaseRequests PurchaseRequest[]
  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  transfersFrom    WarehouseTransfer[] @relation("TransferFrom")
  transfersTo      WarehouseTransfer[] @relation("TransferTo")

  @@map("warehouses")
}

model WarehouseLocation {
  id          String    @id @default(uuid())
  warehouseId String
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  code        String
  name        String?
  createdAt   DateTime  @default(now())

  balances InventoryBalance[]

  @@unique([warehouseId, code])
  @@map("warehouse_locations")
}

model InventoryItem {
  id          String            @id @default(uuid())
  sku         String            @unique
  barcode     String?           @unique
  qrCode      String?           @unique
  nameAr      String
  nameEn      String
  description String?
  category    InventoryCategory @default(OTHER)
  materialType String?
  color       String?
  size        String?
  /// Extra named measurements: [{ id, nameEn, nameAr, nameHe?, value, unit }]
  customMeasurements Json?
  /// Optional photo URL (accessories) — durable /uploads download link
  imageUrl    String?
  unit        String            @default("pcs")
  /// Fixed purchase / catalog unit cost used when creating purchase orders
  standardCost Decimal          @default(0) @db.Decimal(18, 3)
  materialId  String?           @unique
  material    Material?         @relation(fields: [materialId], references: [id])
  preferredSupplierId String?
  preferredSupplier   Supplier? @relation(fields: [preferredSupplierId], references: [id])
  minStock     Decimal           @default(0) @db.Decimal(18, 3)
  maxStock     Decimal?          @db.Decimal(18, 3)
  reorderQty   Decimal?          @db.Decimal(18, 3)
  lastAutoPrAt DateTime?
  isActive     Boolean           @default(true)
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  archivedAt   DateTime?

  balances             InventoryBalance[]
  transactions         InventoryTransaction[]
  purchaseRequestLines PurchaseRequestLine[]
  purchaseOrderLines   PurchaseOrderLine[]
  goodsReceiptLines    GoodsReceiptLine[]
  countLines           InventoryCountLine[]
  transferLines        WarehouseTransferLine[]

  @@index([category])
  @@map("inventory_items")
}

model InventoryBalance {
  id              String             @id @default(uuid())
  inventoryItemId String
  inventoryItem   InventoryItem      @relation(fields: [inventoryItemId], references: [id])
  warehouseId     String
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  locationId      String?
  location        WarehouseLocation? @relation(fields: [locationId], references: [id])
  availableQty    Decimal            @default(0) @db.Decimal(18, 3)
  reservedQty     Decimal            @default(0) @db.Decimal(18, 3)
  damagedQty      Decimal            @default(0) @db.Decimal(18, 3)
  onOrderQty      Decimal            @default(0) @db.Decimal(18, 3)
  updatedAt       DateTime           @updatedAt

  @@unique([inventoryItemId, warehouseId, locationId])
  @@index([warehouseId])
  @@map("inventory_balances")
}

model InventoryTransaction {
  id              String         @id @default(uuid())
  number          String         @unique
  type            InventoryTxType
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  warehouseId     String
  quantity        Decimal        @db.Decimal(18, 3)
  unitCost        Decimal?       @db.Decimal(18, 3)
  referenceType   String?
  referenceId     String?
  notes           String?
  idempotencyKey  String?        @unique
  createdAt       DateTime       @default(now())
  createdById     String?

  @@index([inventoryItemId])
  @@index([warehouseId])
  @@index([createdAt])
  @@map("inventory_transactions")
}

model InventoryCount {
  id          String   @id @default(uuid())
  number      String   @unique
  warehouseId String
  status      String   @default("DRAFT")
  countedAt   DateTime?
  notes       String?
  createdAt   DateTime @default(now())
  createdById String?

  lines InventoryCountLine[]

  @@map("inventory_counts")
}

model InventoryCountLine {
  id              String         @id @default(uuid())
  inventoryCountId String
  inventoryCount  InventoryCount @relation(fields: [inventoryCountId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  systemQty       Decimal        @db.Decimal(18, 3)
  countedQty      Decimal?       @db.Decimal(18, 3)
  varianceQty     Decimal?       @db.Decimal(18, 3)

  @@index([inventoryCountId])
  @@map("inventory_count_lines")
}

model WarehouseTransfer {
  id              String   @id @default(uuid())
  number          String   @unique
  fromWarehouseId String
  fromWarehouse   Warehouse @relation("TransferFrom", fields: [fromWarehouseId], references: [id])
  toWarehouseId   String
  toWarehouse     Warehouse @relation("TransferTo", fields: [toWarehouseId], references: [id])
  status          String   @default("DRAFT")
  notes           String?
  createdAt       DateTime @default(now())
  createdById     String?

  lines WarehouseTransferLine[]

  @@map("warehouse_transfers")
}

model WarehouseTransferLine {
  id              String            @id @default(uuid())
  transferId      String
  transfer        WarehouseTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  inventoryItemId String
  inventoryItem   InventoryItem     @relation(fields: [inventoryItemId], references: [id])
  quantity        Decimal           @db.Decimal(18, 3)

  @@index([transferId])
  @@map("warehouse_transfer_lines")
}

// ─── RFQ & Quotations ────────────────────────────────────────────────────────

model RequestForQuotation {
  id                   String        @id @default(uuid())
  number               String        @unique
  customerId           String
  customer             Customer      @relation(fields: [customerId], references: [id])
  contactName          String?
  source               RequestSource @default(SALES)
  assignedSalesId      String?
  assignedSales        User?         @relation("RequestAssignee", fields: [assignedSalesId], references: [id])
  requestDate          DateTime      @default(now())
  requiredDeliveryDate DateTime?
  status               RequestStatus @default(DRAFT)
  priority             Priority      @default(NORMAL)
  projectName          String?
  deliveryAddress      String?
  /// Dealer's end-customer / PO reference
  externalOrderNumber  String?
  endCustomerName      String?
  endCustomerPhone     String?
  endCustomerFax       String?
  deliveryLat          Decimal?      @db.Decimal(10, 7)
  deliveryLng          Decimal?      @db.Decimal(10, 7)
  currency             String        @default("ILS")
  notes                String?
  internalNotes        String?
  aiProcessingStatus   AIJobStatus?
  /// Set when the dealer (or staff) first submits the RFQ. Edit window anchors here.
  submittedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  createdById          String?
  archivedAt           DateTime?

  items       RequestItem[]
  quotations  Quotation[]
  aiJobs      AIExtractionJob[]
  documents   Document[]

  @@index([customerId])
  @@index([status])
  @@map("requests_for_quotation")
}

model RequestItem {
  id          String              @id @default(uuid())
  requestId   String
  request     RequestForQuotation @relation(fields: [requestId], references: [id], onDelete: Cascade)
  category    String?
  productId   String?
  product     Product?            @relation(fields: [productId], references: [id], onDelete: SetNull)
  productName String
  description String?
  quantity    Decimal             @db.Decimal(18, 3)
  unit        String              @default("pcs")
  width       Decimal?            @db.Decimal(18, 3)
  height      Decimal?            @db.Decimal(18, 3)
  depth       Decimal?            @db.Decimal(18, 3)
  seatHeight  Decimal?            @db.Decimal(18, 3)
  material    String?
  woodType    String?
  woodColor   String?
  fabricType  String?
  fabricCode  String?
  fabricColor String?
  foamDensity String?
  finish      String?
  accessories String?
  notes       String?
  customMeasurements Json?
  sortOrder   Int                 @default(0)

  @@index([requestId])
  @@index([productId])
  @@map("request_items")
}

model Quotation {
  id                   String          @id @default(uuid())
  number               String
  version              Int             @default(1)
  customerId           String
  customer             Customer        @relation(fields: [customerId], references: [id])
  requestId            String?
  request              RequestForQuotation? @relation(fields: [requestId], references: [id])
  issueDate            DateTime        @default(now())
  expirationDate       DateTime?
  currency             String          @default("ILS")
  salesRepId           String?
  salesRep             User?           @relation("QuotationSalesRep", fields: [salesRepId], references: [id])
  status               QuotationStatus @default(DRAFT)
  paymentTerms         String?
  deliveryTerms        String?
  warrantyTerms        String?
  customerNotes        String?
  internalNotes        String?
  subtotal             Decimal         @default(0) @db.Decimal(18, 3)
  discountTotal        Decimal         @default(0) @db.Decimal(18, 3)
  taxTotal             Decimal         @default(0) @db.Decimal(18, 3)
  total                Decimal         @default(0) @db.Decimal(18, 3)
  sentAt               DateTime?
  viewedAt             DateTime?
  acceptedAt           DateTime?
  rejectedAt           DateTime?
  acceptanceSignature  String?
  parentQuotationId    String?
  parentQuotation      Quotation?      @relation("QuotationRevisions", fields: [parentQuotationId], references: [id])
  revisions            Quotation[]     @relation("QuotationRevisions")
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  createdById          String?
  archivedAt           DateTime?

  lines      QuotationLine[]
  approvals  QuotationApproval[]
  salesOrders SalesOrder[]
  documents  Document[]

  @@unique([number, version])
  @@index([customerId])
  @@index([status])
  @@map("quotations")
}

model QuotationLine {
  id            String     @id @default(uuid())
  quotationId   String
  quotation     Quotation  @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  productId     String?
  product       Product?   @relation(fields: [productId], references: [id])
  description   String
  quantity      Decimal    @db.Decimal(18, 3)
  unit          String     @default("pcs")
  width         Decimal?   @db.Decimal(18, 3)
  height        Decimal?   @db.Decimal(18, 3)
  depth         Decimal?   @db.Decimal(18, 3)
  material      String?
  fabric        String?
  color         String?
  unitPrice     Decimal    @db.Decimal(18, 3)
  discountType  DiscountType @default(NONE)
  discountValue Decimal    @default(0) @db.Decimal(18, 3)
  taxRate       Decimal    @default(0) @db.Decimal(5, 4)
  subtotal      Decimal    @db.Decimal(18, 3)
  taxAmount     Decimal    @db.Decimal(18, 3)
  lineTotal     Decimal    @db.Decimal(18, 3)
  sortOrder     Int        @default(0)

  @@index([quotationId])
  @@map("quotation_lines")
}

model QuotationApproval {
  id          String    @id @default(uuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  approverId  String
  approver    User      @relation(fields: [approverId], references: [id])
  decision    String
  comment     String?
  decidedAt   DateTime  @default(now())

  @@index([quotationId])
  @@map("quotation_approvals")
}

// ─── Sales & Contracts ───────────────────────────────────────────────────────

model SalesOrder {
  id                   String           @id @default(uuid())
  number               String           @unique
  customerId           String
  customer             Customer         @relation(fields: [customerId], references: [id])
  quotationId          String?
  quotation            Quotation?       @relation(fields: [quotationId], references: [id])
  orderDate            DateTime         @default(now())
  requiredDeliveryDate DateTime?
  deliveryAddress      String?
  /// Dealer's own / end-customer PO reference (copied from RFQ at accept)
  externalOrderNumber  String?
  currency             String           @default("ILS")
  paymentTerms         String?
  status               SalesOrderStatus @default(DRAFT)
  priority             Priority         @default(NORMAL)
  projectName          String?
  assignedEmployeeId   String?
  notes                String?
  subtotal             Decimal          @default(0) @db.Decimal(18, 3)
  taxTotal             Decimal          @default(0) @db.Decimal(18, 3)
  total                Decimal          @default(0) @db.Decimal(18, 3)
  /// Factory manufacturing cost (admin-only)
  manufacturingCost    Decimal?         @db.Decimal(18, 3)
  /// { fabricQty, fabricCost, woodQty, woodCost, foamQty, foamCost, accessoriesQty, accessoriesCost }
  costBreakdown        Json?
  receivingDate        DateTime?
  depositRequired      Decimal?         @db.Decimal(18, 3)
  cancellationReason   String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  createdById          String?
  archivedAt           DateTime?

  lines            SalesOrderLine[]
  contracts        Contract[]
  productionOrders ProductionOrder[]
  deliveries       Delivery[]
  invoices         Invoice[]
  returns          ReturnRequest[]
  documents        Document[]

  @@index([customerId])
  @@index([status])
  @@map("sales_orders")
}

model SalesOrderLine {
  id                 String     @id @default(uuid())
  salesOrderId       String
  salesOrder         SalesOrder @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  productId          String?
  product            Product?   @relation(fields: [productId], references: [id])
  description        String
  specifications     String?
  quantity           Decimal    @db.Decimal(18, 3)
  unitPrice          Decimal    @db.Decimal(18, 3)
  discountValue      Decimal    @default(0) @db.Decimal(18, 3)
  taxRate            Decimal    @default(0) @db.Decimal(5, 4)
  lineTotal          Decimal    @db.Decimal(18, 3)
  productionRequired Boolean    @default(true)
  deliveryRequired   Boolean    @default(true)
  sortOrder          Int        @default(0)

  productionOrders ProductionOrder[]

  @@index([salesOrderId])
  @@map("sales_order_lines")
}

model Contract {
  id            String         @id @default(uuid())
  number        String         @unique
  customerId    String
  customer      Customer       @relation(fields: [customerId], references: [id])
  salesOrderId  String?
  salesOrder    SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  startDate     DateTime?
  endDate       DateTime?
  contractValue Decimal        @db.Decimal(18, 3)
  currency      String         @default("ILS")
  paymentSchedule String?
  deliveryMilestones String?
  warranty      String?
  terms         String?
  status        ContractStatus @default(DRAFT)
  signedDocId   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  archivedAt    DateTime?

  @@index([customerId])
  @@map("contracts")
}

// ─── Production ──────────────────────────────────────────────────────────────

model ProductionStageDefinition {
  id                    String   @id @default(uuid())
  code                  String   @unique
  nameAr                String
  nameEn                String
  nameHe                String?
  sortOrder             Int
  estimatedHours        Decimal? @db.Decimal(8, 2)
  requiresInspection    Boolean  @default(false)
  requiresPhotos        Boolean  @default(false)
  responsibleDepartment String?
  /// Stage codes that must be COMPLETED before this stage can become READY
  dependsOnCodes        String[] @default([])
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  instances ProductionStageInstance[]
  tasks     ProductionTask[]
  stageEstimates ProductStageEstimate[]
  workerSkills   WorkerSkill[]
  estimateStats  StageEstimateStat[]
  workflowNodes  ProductionWorkflowNode[]
  snapshotNodes  ProductionOrderWorkflowSnapshotNode[]
  stageOverrides ProductWorkflowStageOverride[]

  @@map("production_stage_definitions")
}

model ProductionOrder {
  id                    String                @id @default(uuid())
  number                String                @unique
  salesOrderId          String?
  salesOrder            SalesOrder?           @relation(fields: [salesOrderId], references: [id])
  salesOrderLineId      String?
  salesOrderLine        SalesOrderLine?       @relation(fields: [salesOrderLineId], references: [id])
  customerId            String?
  productId             String?
  product               Product?              @relation(fields: [productId], references: [id])
  productDescription    String
  quantity              Decimal               @db.Decimal(18, 3)
  specifications        String?
  requiredDeliveryDate  DateTime?
  /// Mirror of approved ProductionSchedule.committedDeliveryDate for list filters
  committedDeliveryDate DateTime?
  plannedStartDate      DateTime?
  plannedCompletionDate DateTime?
  actualStartDate       DateTime?
  actualCompletionDate  DateTime?
  priority              Priority              @default(NORMAL)
  currentStageCode      String?
  progressPercent       Int                   @default(0)
  status                ProductionOrderStatus @default(DRAFT)
  supervisorId          String?
  notes                 String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  createdById           String?
  archivedAt            DateTime?

  stages       ProductionStageInstance[]
  tasks        ProductionTask[]
  inspections  QualityInspection[]
  reworkRequests ReworkRequest[]
  documents    Document[]
  schedules    ProductionSchedule[]
  estimateProposals SchedulingEstimateProposal[]
  workflowSnapshot ProductionOrderWorkflowSnapshot?

  @@index([salesOrderId])
  @@index([status])
  @@index([requiredDeliveryDate])
  @@index([committedDeliveryDate])
  @@index([plannedStartDate])
  @@index([plannedCompletionDate])
  @@map("production_orders")
}

model ProductionStageInstance {
  id                String              @id @default(uuid())
  productionOrderId String
  productionOrder   ProductionOrder     @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageDefinitionId String
  stageDefinition   ProductionStageDefinition @relation(fields: [stageDefinitionId], references: [id])
  status            StageInstanceStatus @default(PENDING)
  plannedStart      DateTime?
  plannedEnd        DateTime?
  actualStart       DateTime?
  actualEnd         DateTime?
  progressPercent   Int                 @default(0)
  notes             String?
  inspectionStatus  String?

  tasks       ProductionTask[]
  allocations ScheduleAllocation[]

  @@index([productionOrderId])
  @@index([plannedStart])
  @@index([plannedEnd])
  @@map("production_stage_instances")
}

model ProductionTask {
  id                  String                     @id @default(uuid())
  number              String                     @unique
  productionOrderId   String
  productionOrder     ProductionOrder            @relation(fields: [productionOrderId], references: [id], onDelete: Cascade)
  stageDefinitionId   String?
  stageDefinition     ProductionStageDefinition? @relation(fields: [stageDefinitionId], references: [id])
  stageInstanceId     String?
  stageInstance       ProductionStageInstance?   @relation(fields: [stageInstanceId], references: [id])
  name                String
  description         String?
  assignedEmployeeId  String?
  assignedEmployee    User?                      @relation("TaskAssignee", fields: [assignedEmployeeId], references: [id])
  priority            Priority                   @default(NORMAL)
  plannedStart        DateTime?
  plannedCompletion   DateTime?
  actualStart         DateTime?
  actualCompletion    DateTime?
  progressPercent     Int                        @default(0)
  status              TaskStatus                 @default(NOT_STARTED)
  estimatedMinutes    Int?
  actualMinutes       Int?
  notes               String?
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  timeEntries TaskTimeEntry[]
  blockers    TaskBlocker[]
  allocations ScheduleAllocation[]

  @@index([productionOrderId])
  @@index([assignedEmployeeId])
  @@index([status])
  @@index([plannedStart])
  @@index([plannedCompletion])
  @@index([assignedEmployeeId, plannedStart])
  @@map("production_tasks")
}

model TaskTimeEntry {
  id        String         @id @default(uuid())
  taskId    String
  task      ProductionTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId    String
  user      User           @relation(fields: [userId], references: [id])
  startedAt DateTime
  endedAt   DateTime?
  minutes   Int?

  @@index([taskId])
  @@map("task_time_entries")
}

model TaskBlocker {
  id           String          @id @default(uuid())
  taskId       String
  task         ProductionTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  category     BlockerCategory
  reason       String
  reportedById String?
  reportedBy   User?           @relation("BlockerReporter", fields: [reportedById], references: [id])
  resolvedAt   DateTime?
  resolution   String?
  createdAt    DateTime        @default(now())

  @@index([taskId])
  @@map("task_blockers")
}

// ─── Quality ─────────────────────────────────────────────────────────────────

model QualityChecklistTemplate {
  id        String   @id @default(uuid())
  code      String   @unique
  nameAr    String
  nameEn    String
  stageCode String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  items QualityChecklistItem[]

  @@map("quality_checklist_templates")
}

model QualityChecklistItem {
  id         String                   @id @default(uuid())
  templateId String
  template   QualityChecklistTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  code       String
  labelAr    String
  labelEn    String
  sortOrder  Int                      @default(0)

  @@index([templateId])
  @@map("quality_checklist_items")
}

model QualityInspection {
  id                String        @id @default(uuid())
  number            String        @unique
  productionOrderId String
  productionOrder   ProductionOrder @relation(fields: [productionOrderId], references: [id])
  stageCode         String?
  inspectorId       String?
  inspector         User?         @relation(fields: [inspectorId], references: [id])
  inspectedAt       DateTime      @default(now())
  result            QualityResult?
  notes             String?
  createdAt         DateTime      @default(now())

  items   QualityInspectionItem[]
  defects QualityDefect[]
  rework  ReworkRequest[]

  @@index([productionOrderId])
  @@map("quality_inspections")
}

model QualityInspectionItem {
  id            String             @id @default(uuid())
  inspectionId  String
  inspection    QualityInspection  @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  checklistCode String
  label         String
  result        ChecklistItemResult?
  note          String?
  severity      String?

  @@index([inspectionId])
  @@map("quality_inspection_items")
}

model QualityDefect {
  id             String            @id @default(uuid())
  inspectionId   String
  inspection     QualityInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  description    String
  stageCode      String?
  severity       String
  correctiveAction String?

  @@index([inspectionId])
  @@map("quality_defects")
}

model ReworkRequest {
  id                String             @id @default(uuid())
  number            String             @unique
  productionOrderId String
  productionOrder   ProductionOrder    @relation(fields: [productionOrderId], references: [id])
  inspectionId      String?
  inspection        QualityInspection? @relation(fields: [inspectionId], references: [id])
  description       String
  assignedToId      String?
  status            String             @default("OPEN")
  createdAt         DateTime           @default(now())
  completedAt       DateTime?

  @@index([productionOrderId])
  @@map("rework_requests")
}

// ─── Delivery ────────────────────────────────────────────────────────────────

model Delivery {
  id              String         @id @default(uuid())
  number          String         @unique
  salesOrderId    String?
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])
  customerId      String
  customer        Customer       @relation(fields: [customerId], references: [id])
  deliveryAddress String
  latitude        Decimal?       @db.Decimal(10, 7)
  longitude       Decimal?       @db.Decimal(10, 7)
  deliveryDate    DateTime?
  deliveryWindow  String?
  driverId        String?
  driver          User?          @relation("DeliveryDriver", fields: [driverId], references: [id])
  vehicle         String?
  status          DeliveryStatus @default(PLANNED)
  recipientName   String?
  signatureData   String?
  failureReason   String?
  notes           String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  items DeliveryItem[]

  @@index([customerId])
  @@index([status])
  @@map("deliveries")
}

model DeliveryItem {
  id          String   @id @default(uuid())
  deliveryId  String
  delivery    Delivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(18, 3)

  @@index([deliveryId])
  @@map("delivery_items")
}

// ─── Accounting ──────────────────────────────────────────────────────────────

model Invoice {
  id                String        @id @default(uuid())
  number            String        @unique
  customerId        String
  customer          Customer      @relation(fields: [customerId], references: [id])
  salesOrderId      String?
  salesOrder        SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  invoiceDate       DateTime      @default(now())
  dueDate           DateTime?
  currency          String        @default("ILS")
  status            InvoiceStatus @default(DRAFT)
  subtotal          Decimal       @default(0) @db.Decimal(18, 3)
  discountTotal     Decimal       @default(0) @db.Decimal(18, 3)
  taxTotal          Decimal       @default(0) @db.Decimal(18, 3)
  total             Decimal       @default(0) @db.Decimal(18, 3)
  paidAmount        Decimal       @default(0) @db.Decimal(18, 3)
  outstandingAmount Decimal       @default(0) @db.Decimal(18, 3)
  notes             String?
  jofotaraUuid      String?
  jofotaraQr        String?
  jofotaraStatus    String?
  jofotaraClearedAt DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  createdById       String?
  archivedAt        DateTime?

  lines    InvoiceLine[]
  payments Payment[]

  @@index([customerId])
  @@index([status])
  @@map("invoices")
}

model InvoiceLine {
  id          String  @id @default(uuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal @db.Decimal(18, 3)
  unitPrice   Decimal @db.Decimal(18, 3)
  taxRate     Decimal @default(0) @db.Decimal(5, 4)
  lineTotal   Decimal @db.Decimal(18, 3)
  sortOrder   Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_lines")
}

model Payment {
  id              String        @id @default(uuid())
  number          String        @unique
  customerId      String
  customer        Customer      @relation(fields: [customerId], references: [id])
  invoiceId       String?
  invoice         Invoice?      @relation(fields: [invoiceId], references: [id])
  paymentDate     DateTime      @default(now())
  amount          Decimal       @db.Decimal(18, 3)
  currency        String        @default("ILS")
  method          PaymentMethod @default(BANK_TRANSFER)
  referenceNumber String?
  bank            String?
  notes           String?
  createdAt       DateTime      @default(now())
  createdById     String?
  idempotencyKey  String?       @unique

  @@index([customerId])
  @@index([invoiceId])
  @@map("payments")
}

model StatementEntry {
  id          String   @id @default(uuid())
  customerId  String
  customer    Customer @relation(fields: [customerId], references: [id])
  entryDate   DateTime
  type        String
  reference   String?
  debit       Decimal  @default(0) @db.Decimal(18, 3)
  credit      Decimal  @default(0) @db.Decimal(18, 3)
  balance     Decimal  @db.Decimal(18, 3)
  description String?
  createdAt   DateTime @default(now())

  @@index([customerId, entryDate])
  @@map("statement_entries")
}

// ─── Supplier AP (accounts payable) ──────────────────────────────────────────

model SupplierInvoice {
  id                String        @id @default(uuid())
  number            String        @unique
  supplierId        String
  supplier          Supplier      @relation(fields: [supplierId], references: [id])
  purchaseOrderId   String
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
