# Maher Al-Aghbar & Sons Furniture ERP — local defaults
# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
TZ=Asia/Amman

# Database
DATABASE_URL=postgresql://maher:maher@127.0.0.1:5432/maher_erp?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false
# Optional. AES key for dealer portal-password reveal (falls back to JWT_ACCESS_SECRET).
# PORTAL_PASSWORD_KEY=

# Apps
API_URL=http://localhost:4000
ADMIN_WEB_URL=http://localhost:3000
CUSTOMER_PORTAL_URL=http://localhost:3001
EMPLOYEE_PORTAL_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ADMIN_WEB_URL=http://localhost:3000
NEXT_PUBLIC_CUSTOMER_PORTAL_URL=http://localhost:3001
NEXT_PUBLIC_EMPLOYEE_PORTAL_URL=http://localhost:3002
API_PORT=4000

# Storage (local disk by default; MinIO optional)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=maher-erp
S3_FORCE_PATH_STYLE=true
FILE_URL_TTL_SECONDS=900
LOCAL_UPLOAD_DIR=./uploads
# Opt-in: STORAGE_PROVIDER=s3 (otherwise local disk)

# Optional Google Geocoding (otherwise Nominatim via GET /api/v1/geo/*)
GOOGLE_MAPS_API_KEY=
# Business (always quote values with spaces or Arabic)
DEFAULT_CURRENCY=ILS
DEFAULT_LOCALE=ar
DEFAULT_VAT_RATE=0.16
# Optional hourly labor proxy for period P&L report (ILS)
DEFAULT_LABOR_RATE_ILS=5
DEFAULT_LABOR_RATE_JOD=5
COMPANY_NAME_AR="مفروشات ماهر الأغبر وأولاده"
COMPANY_NAME_EN="Maher Al-Aghbar & Sons Furniture"

# Providers (mock in local; set live keys below)
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
AI_PROVIDER=mock
OCR_PROVIDER=mock
# Free/local OCR (no cloud key): local|tesseract|pdf|auto — uses pdf-parse + tesseract.js
# OCR_PROVIDER=local
VIRUS_SCAN_PROVIDER=noop

# Optional live providers (leave empty locally)
# EMAIL_PROVIDER=resend  + RESEND_API_KEY=re_…
# EMAIL_PROVIDER=smtp    + SMTP_URL=smtp://user:pass@host:587
# AI_PROVIDER=openai when OPENAI_API_KEY is present.
# OCR_PROVIDER=openai|google|local|mock
OPENAI_API_KEY=
OCR_API_KEY=
OCR_API_URL=
AI_LLM_MODEL=gpt-4o-mini
# System chatbot (ERP Q&A). Default on when OPENAI_API_KEY is set; use deterministic offline router with AI_CHAT_MODE=deterministic.
AI_CHAT_ENABLED=true
# AI_CHAT_MODE=deterministic
RESEND_API_KEY=
SMTP_URL=
SMTP_FROM=Maher Al-Aghbar <beth.t@example.com>

# Inbound dealer RFQ email (IMAP poll in worker + webhook stub on API)
# Leave unset locally — worker logs mock heartbeat, no inbox polling.
EMAIL_INBOUND_HOST=
EMAIL_INBOUND_PORT=993
EMAIL_INBOUND_SECURE=true
EMAIL_INBOUND_USER=
EMAIL_INBOUND_PASS=
EMAIL_INBOUND_MAILBOX=INBOX
EMAIL_INBOUND_POLL_INTERVAL_MS=60000
# Shared secret for POST /api/v1/webhooks/inbound-email (worker + external providers)
EMAIL_INBOUND_WEBHOOK_SECRET=
# Optional extra email alert in addition to in-app admin notifications
EMAIL_INBOUND_ADMIN_NOTIFY_EMAIL=

# Inbound WhatsApp RFQ webhook (Meta Cloud API or simplified JSON)
# POST /api/v1/webhooks/inbound-whatsapp  header: x-inbound-whatsapp-secret
WHATSAPP_INBOUND_WEBHOOK_SECRET=
# Meta subscription verify token for GET /api/v1/webhooks/inbound-whatsapp
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Twilio SMS from number (E.164), e.g. +9627…
TWILIO_SMS_FROM=
# Twilio WhatsApp sender, e.g. whatsapp:+14155238886 or +14155238886
TWILIO_WHATSAPP_FROM=
# Alias used if TWILIO_SMS_FROM / TWILIO_WHATSAPP_FROM unset
TWILIO_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_PROVIDER=meta|twilio|console
# SMS_PROVIDER=twilio|console

# JoFotara e-invoicing (Jordan) — mock clearance when keys absent
JOFOTARA_CLIENT_ID=
JOFOTARA_SECRET_KEY=
JOFOTARA_BASE_URL=https://backend.jofotara.gov.jo/core/invoices/
