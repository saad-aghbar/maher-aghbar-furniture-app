# Maher Al-Aghbar & Sons Furniture ERP — local defaults
# Copy to .env and adjust. Never commit real secrets.

NODE_ENV=development
TZ=Asia/Amman

# Database
DATABASE_URL=postgresql://maher:maher@127.0.0.1:5432/maher_erp?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_ACCESS_SECRET=dev-access-secret-change-me-min-32-chars!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me-min-32-chars!
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Apps
API_URL=http://localhost:4000
ADMIN_WEB_URL=http://localhost:3000
CUSTOMER_PORTAL_URL=http://localhost:3001
EMPLOYEE_PORTAL_URL=http://localhost:3002
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:4000
API_PORT=4000

# Storage (local disk by default; MinIO optional)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=maher-erp
S3_FORCE_PATH_STYLE=true
FILE_URL_TTL_SECONDS=900
LOCAL_UPLOAD_DIR=./uploads

# Business (always quote values with spaces or Arabic)
DEFAULT_CURRENCY=JOD
DEFAULT_LOCALE=ar
DEFAULT_VAT_RATE=0.16
COMPANY_NAME_AR="مفروشات ماهر الأغبر وأولاده"
COMPANY_NAME_EN="Maher Al-Aghbar & Sons Furniture"

# Providers (mock in local)
EMAIL_PROVIDER=console
SMS_PROVIDER=console
WHATSAPP_PROVIDER=console
AI_PROVIDER=mock
OCR_PROVIDER=mock
VIRUS_SCAN_PROVIDER=noop

# Optional live providers (leave empty locally)
OPENAI_API_KEY=
OCR_API_KEY=
SMTP_URL=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
